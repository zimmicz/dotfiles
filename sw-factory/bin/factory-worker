#!/bin/zsh
set -uo pipefail

MAX=${MAX:-10}
SLOTS=${SLOTS:-3} IMPL_SLOTS=${IMPL_SLOTS:-1} MR_SLOTS=${MR_SLOTS:-1} VERIFY_SLOTS=${VERIFY_SLOTS:-1} REVIEW_SLOTS=${REVIEW_SLOTS:-1}
REPOS=~/work/cleverfarm/repos
LOG_DIR=~/.local/state/sw-factory
AI_MARK="AI triage (Claude, headless)"
NOTES=$LOG_DIR/notes.txt
HOLDOUT=$LOG_DIR/holdout
SELF=${0:A}
LOCKS=$LOG_DIR/locks
SLOTDIR=$LOG_DIR/slots
HANDLED=$LOG_DIR/handled
STALLED=$LOG_DIR/stalled
GLHANDLED=$LOG_DIR/handled-mr
TNOTES=$LOG_DIR/notes
SUSPECT=$LOG_DIR/holdout-suspect
PROPOSED=$LOG_DIR/holdout-proposed
SENT=$LOG_DIR/sent
ENVOWN=$LOG_DIR/env-owned
ENVHANDLED=$LOG_DIR/handled-env
UNVERIFIED=$LOG_DIR/unverified
ENVPROJ=cleverfarm%2Fcleverfarm%2Finfrastructure%2Fcf-dev-kubernetes
CF_ENV=$(find ~/.claude/plugins/cache -type f -name cf-env.sh -path '*/cf-dyn-env/*' 2>/dev/null | sort -V | tail -1)
mkdir -p $LOG_DIR $HOLDOUT $TNOTES $LOCKS $SLOTDIR $HANDLED $STALLED $GLHANDLED $SUSPECT $PROPOSED $SENT $ENVOWN $ENVHANDLED $UNVERIFIED ~/cf-env-tmp

HEADLESS_SETTINGS='{"enabledPlugins":{"caveman@caveman":false,"ponytail@ponytail":false,"slack@claude-plugins-official":false,"cf-planning@cleverfarm":false,"cf-release@cleverfarm":false,"cf-kb@cleverfarm":false,"cf-eod@cleverfarm":false,"cf-bug-report@cleverfarm":false,"cf-cli-skill@cleverfarm":false,"cf-investigator@cleverfarm":false,"cf-cc@cleverfarm":false,"typescript-lsp@claude-plugins-official":false}}'
NO_SHIP="Bash(git push:*) Bash(git commit:*) Bash(git reset --hard:*) Bash(glab mr merge:*) Bash(glab mr approve:*)"
NO_REPO_WRITE="Edit(/$REPOS/**) Write(/$REPOS/**)"
export MCP_TIMEOUT=${MCP_TIMEOUT:-120000}
PW_ARGS='["--prefer-offline","-y","@playwright/mcp@0.0.83","--headless","--executable-path","/usr/bin/chromium","--caps","devtools","--secrets","'"$HOME"'/.config/cleverfarm/e2e.env"]'

mcp_config() {
  local PW=${1:-}; shift
  jq -nc --arg pw "$PW" --argjson pwargs "$PW_ARGS" --slurpfile c ~/.claude.json --args '
    ($c[0].mcpServers + {codegraph: {type: "stdio", command: "codegraph", args: ["serve", "--mcp"]}} | with_entries(select(.key | IN($ARGS.positional[])))) as $m
    | {mcpServers: ($m + (if $pw == "" then {} else {playwright: {type: "stdio", command: "npx", args: ($pwargs + ["--output-dir", $pw])}} end))}' "$@"
}

STREAM_JQ='def ctx: ((.message.usage.input_tokens // 0) + (.message.usage.cache_read_input_tokens // 0) + (.message.usage.cache_creation_input_tokens // 0));
foreach inputs as $m ({b: 0, n: 0, c: 0, peak: 0};
  (if $m.type == "assistant" then .n += 1 | .c = ($m | ctx) | .peak = ([.peak, .c] | max) | .nb = ((.c / 50000) | floor) else .nb = .b end)
  | .lines = ((now | localtime | strftime("%T")) as $t
    | [ (if $m.type == "system" and $m.subtype == "init" then ("🆔 session \($m.session_id) — reopen: cd \($m.cwd) && claude --resume \($m.session_id) — transcript ~/.claude/projects/\($m.cwd | gsub("[/.]"; "-"))/\($m.session_id).jsonl", ($m.mcp_servers[]? | select(.status != "connected") | "⚠️ mcp \(.name) \(.status)"))
        elif $m.type == "system" and $m.subtype == "compact_boundary" then "🧹 compacted (\($m.compactMetadata.trigger // "?"), \((($m.compactMetadata.preTokens // 0) / 1000) | floor)K before)"
        elif $m.type == "assistant" then ($m.message.content[] | if .type == "text" then "💬 " + .text elif .type == "tool_use" then "🔧 " + .name + " " + (.input | tostring)[0:200] else empty end)
        elif $m.type == "result" then "✅ exit error=\($m.is_error) cost=$\($m.total_cost_usd) turns=\(.n) peak=\((.peak / 1000) | floor)K\n\($m.result // "")" else empty end),
        (if .nb > .b then "📏 ctx \((.c / 1000) | floor)K (turn \(.n))" else empty end)
      ] | map("\($t) \(.)"))
  | .b = (if $m.type == "system" and $m.subtype == "compact_boundary" then 0 else ([.b, .nb] | max) end);
  .lines[])'

LIMIT=$LOG_DIR/.limit

limit_mark() {
  local NOW=$(date +%s) T=$(date -d "${${${1#*resets }%% \(*}//,/}" +%s 2>/dev/null || echo 0)
  (( T )) || T=$(( NOW + 1800 ))
  (( T <= NOW )) && (( T += 86400 ))
  echo $(( T + 60 )) >$LIMIT
  touch $LIMIT.$$
}

limited() { [[ -f $LIMIT.$$ ]] }

limit_bail() {
  limited || return 0
  rm -f $LIMIT.$$
  echo "  usage limit hit, stage abandoned, labels untouched, re-runs after $(date -d @$(<$LIMIT) '+%a %H:%M')" | tee -a $LOG_DIR/$1.log
  exit 2
}

stream() {
  local L
  jq --unbuffered -nr "$STREAM_JQ" | while IFS= read -r L; do
    print -r -- "$L"
    if [[ $L == "You've hit your "*limit* ]]; then limit_mark "$L"; fi
  done
}

jql() { jira GET "/rest/api/3/search/jql?jql=$(jq -rn --arg q "$1" '$q|@uri')&fields=$2&maxResults=$3" }

search() { jql "${1/#project = DEV AND /project = DEV AND (assignee = currentUser() OR assignee is EMPTY) AND }" labels,comment $2 }

JME=$(jira GET /rest/api/3/myself | jq -r '.accountId // empty')
[[ -n "$JME" ]] || { echo "lookup failed: jira myself (accountId), refusing to read comments"; exit 1 }
HUMAN_JQ='def txt: (.body // "" | if type == "string" then . else [.. | .text? // empty] | join("") end);
def ai: txt | contains($m);
def pinged: (.body // "") | (if type == "string" then [scan("\\[~(?:accountid:)?([^\\]]+)\\]") | .[0]] else [.. | objects | select(.type == "mention") | .attrs.id] end) | any(. != "'$JME'");
def envc: txt | test("^\\s*env:"; "i");
def mine: (ai | not) and .author.accountId == "'$JME'" and (pinged | not);
def human: mine and (envc | not);
def envcmd: mine and envc;'
GL_PINGED='def pinged: [.body | scan("(?:^|[^\\w.@/`])@([\\w.-]*\\w)") | .[0]] | any(. != $me);'

handled_json() {
  local F
  for F in ${1:-$HANDLED}/*(N); do echo "${F:t} $(<$F)"; done \
    | jq -Rn '[inputs | split(" ") | select(length == 2) | {(.[0]): (.[1] | tonumber)}] | add // {}'
}

snap_human() {
  jira GET "/rest/api/3/issue/$1/comment?maxResults=1000" | jq -r --arg m "$AI_MARK" "$HUMAN_JQ"' [.comments[] | select(human) | .id | tonumber] | max // 0'
}

snap_all() {
  jira GET "/rest/api/3/issue/$1/comment?maxResults=1000" | jq -r '[.comments[].id | tonumber] | max // 0'
}

mark_handled() { limit_bail $1; echo ${2:-0} >$HANDLED/$1 }

has_label() {
  jira GET "/rest/api/2/issue/$1?fields=labels" | jq -e '.fields.labels as $l | any($ARGS.positional[]; . as $x | $l | index($x) != null)' --args "${@:2}" >/dev/null
}

grill_outcome() { head -1 $LOG_DIR/$1.grill 2>/dev/null; }
plan_ok() {
  local M=()
  [[ -f $1 ]] || { echo "  PLAN.md missing" | tee -a $2; return 1 }
  grep -qE '^## (Requirements|Belongs in Sentry)' $1 || M+=("## Requirements/Belongs in Sentry?")
  grep -q '^## Plan$' $1 || M+=("## Plan")
  grep -q '^## Implementation$' $1 || M+=("## Implementation")
  grep -q '^## Requirements' $1 && ! grep -q '^### Acceptance criteria$' $1 && M+=("### Acceptance criteria")
  (( $#M )) || return 0
  echo "  PLAN.md lacks: ${(j:, :)M}" | tee -a $2
  return 1
}

unrunnable() {
  local F=$HOLDOUT/$1.md
  [[ -f $F ]] || return 1
  awk '/^## S/{if(n&&!b)ok=1; n=1; b=0} /DATA: missing|^Given: same as S/{b=1} END{exit (n&&!b)||ok ? 1 : 0}' $F || return 1
  grep -m1 -o 'DATA: missing.*' $F
}

DATA_RE='^S[0-9]+ [^—]*: blocked — DATA:'
NOPREVIEW_SED='s/^(## )?(S[0-9]+): *(.*)$/\2 \3: blocked — NO PREVIEW: can-frontend has no reachable preview, check by hand/p'

data_only() {
  grep -qE '^S[0-9]+ [^—]*: (fail|not run)' $1 && return 1
  grep -qE '^S[0-9]+ [^—]*: pass' $1 || return 1
  grep -E '^S[0-9]+ [^—]*: blocked' $1 | grep -vqE "$DATA_RE" && return 1
  grep -E "$DATA_RE" $1 | grep -oE '^S[0-9]+' | paste -sd, -
}

grill_bump() {
  echo $(( $(<$LOG_DIR/$1.round 2>/dev/null || echo 0) + 1 )) >$LOG_DIR/$1.round
  date +%s >$STALLED/$1.ask
  rm -f $STALLED/$1.askalert
}

grill_remind() {
  local S=$STALLED/$1.ask A=$STALLED/$1.askalert NOW=$(date +%s)
  [[ -f $S ]] || { echo $NOW >$S; return }
  [[ -f $A ]] && return
  (( NOW - $(<$S) < ${GRILL_REMIND_HOURS:-24} * 3600 )) && return
  note $1 "questions waiting for you in Jira for $(( (NOW - $(<$S)) / 3600 )) h (\`needs-answer\`)"
  echo $NOW >$A
}

answered_since() {
  jira GET "/rest/api/3/issue/$1/comment?maxResults=1000" \
    | jq -e --arg m "$AI_MARK" --argjson id ${2:-0} "$HUMAN_JQ"' any(.comments[]; ai and ((.id | tonumber) > $id))' >/dev/null
}

fallback_comment() {
  limit_bail $1
  answered_since $1 $2 && return 1
  local R=$(jq -r 'select(.type == "result") | .result // empty' $LOG_DIR/$1.stream.jsonl 2>/dev/null)
  [[ -n "$R" ]] || return 1
  jira add-comment $1 "🤖 _${AI_MARK}. Píšu za Michala. Jestli se vám to nelíbí, dejte mi prosím vědět._
Běh skončil bez komentáře v Jiře, tady je jeho závěr:
{noformat}
$R
{noformat}" >/dev/null
}

reply_filter() {
  jq -r --arg m "$AI_MARK" --argjson w $1 --argjson H "$(handled_json)" "$HUMAN_JQ"' .issues[]
    | select((.fields.comment.comments // []) as $c
      | ($c | map(select(human)) | last) as $h
      | (if $h == null then false
         elif $H[.key] != null then (($h.id | tonumber) > $H[.key])
         else (($h.id | tonumber) > ($c | map(select(ai) | .id | tonumber) | max // 0)) end) == $w)' \
    | jq -rs "{issues: .} | $ROWS_JQ"
}

awaiting_reply() { reply_filter true }
not_awaiting() { reply_filter false }

note() {
  limit_bail $1
  local F=$SENT/$1
  local -a R=($F(Nmh-24))
  (( ${#R} )) && [[ "$(<$F)" == "$2" ]] && { info $1 "Slack skipped, same as last note: $2"; return }
  print -r -- "$2" >$F
  echo "[$1](https://cleverfarm.atlassian.net/browse/$1) $2" >>$NOTES
}

info() {
  limit_bail $1
  print -r -- "  info: $2" >>$LOG_DIR/$1.log
}

relabel() {
  limit_bail $1
  local OPS="{\"add\":\"$3\"}"
  [[ -n "$2" ]] && OPS="{\"remove\":\"$2\"},$OPS"
  jira PUT "/rest/api/2/issue/$1" "{\"update\":{\"labels\":[$OPS]}}" >/dev/null
}

unlabel() {
  limit_bail $1
  jira PUT "/rest/api/2/issue/$1" "{\"update\":{\"labels\":[{\"remove\":\"$2\"}]}}" >/dev/null
}

resolve_sentry() {
  local KEY=$1; shift
  claude -p "Sentry org cleverfarm-sro, regionUrl https://us.sentry.io. No human present, never ask. For EACH of these issue short ids: $* -> update_issue status 'resolved', reason 'Jira $KEY released'. A 404 / 'does not exist' error means the issue is already gone (deleted or merged): count it as succeeded. Final answer: 'done' if all succeeded, else the errors." \
    --model haiku --allowedTools "mcp__claude_ai_Sentry__update_issue" --output-format json </dev/null 2>>$LOG_DIR/$KEY.log \
    | tee >(jq -r '"  sentry resolve: \(.result)"' >>$LOG_DIR/$KEY.log) \
    | jq -e '(.is_error | not) and (.permission_denials | length == 0) and (.result | test("^done"; "i"))' >/dev/null
}

analyze() {
  local KEY=$1 REPO=${2-} LOG=$LOG_DIR/$1.log
  echo "=== $KEY ($REPO) $(date -Iseconds)" | tee -a $LOG
  if [[ -z "$REPO" || ! -d $REPOS/$REPO/.git ]]; then
    echo "  no repo '$REPO'" | tee -a $LOG
    return 1
  fi
  local SETUP=$(cd $REPOS/$REPO && cf-work $KEY --no-launch --no-claim --comments-after $(<$HANDLED/$KEY 2>/dev/null || echo 0) 2>&1)
  echo "$SETUP" >>$LOG
  local WT=($REPOS/$REPO/.worktrees/${KEY}-*(N/[1]))
  local TIER=$(grep -oP 'claude --model \K\w+' <<<"$SETUP" || echo sonnet)
  local DIRS=(); for D in ${(u)${(f)"$(grep -oP -- '--add-dir \K\S+' <<<"$SETUP")"}}; do DIRS+=(--add-dir $D); done
  TIER=${TIER/opusplan/opus}
  if [[ -z "$WT" ]]; then
    echo "  worktree setup failed" | tee -a $LOG
    return 1
  fi
  wm_window $WT $LOG; local GARGS=""
  if [[ -n "${GRILL:-}" ]]; then
    rm -f $LOG_DIR/$KEY.grill
    GARGS=" --grill --round $(( $(<$LOG_DIR/$KEY.round 2>/dev/null || echo 0) + 1 ))"
  fi
  (cd $WT && claude -p "/cf-work-headless $KEY$GARGS" \
    --model $TIER $DIRS --settings "$HEADLESS_SETTINGS" \
    --allowedTools "Read Write(./PLAN.md) Edit(./PLAN.md) Write(/$LOG_DIR/$KEY.grill) Write(/$TNOTES/$KEY.md) Edit(/$TNOTES/$KEY.md) Write(/$HOLDOUT/$KEY.md) Edit(/$HOLDOUT/$KEY.md) Write(/$HOLDOUT/$KEY.api.md) Edit(/$HOLDOUT/$KEY.api.md) mcp__lean-ctx__ctx_read mcp__lean-ctx__ctx_search mcp__lean-ctx__ctx_glob mcp__lean-ctx__ctx_tree mcp__lean-ctx__ctx_compose mcp__codegraph__codegraph_explore mcp__claude_ai_Sentry__get_sentry_resource mcp__claude_ai_Sentry__search_errors Bash(git log:*) Bash(git show:*) Bash(git blame:*) Bash(git grep:*) Bash(jira add-comment:*)" \
    --disallowedTools "$NO_SHIP Bash(jira POST:*) Bash(jira PUT:*) Bash(jira DELETE:*)" \
    --output-format stream-json --verbose </dev/null 2>>$LOG | stream >>$LOG) \
    && { [[ "$(grill_outcome $KEY)" == ASK ]] || plan_ok $WT/PLAN.md $LOG; } \
    && echo "  ok -> $WT/PLAN.md${$(grill_outcome $KEY):+ (grill: $(grill_outcome $KEY))}" | tee -a $LOG
  local RC=$? F
  for F in $HOLDOUT/$KEY.md:holdout.md $HOLDOUT/$KEY.api.md:holdout.api.md $WT/PLAN.md:PLAN.md; do
    [[ -f ${F%%:*} ]] && { jira attach $KEY ${F%%:*} ${F##*:} >/dev/null || echo "  attach failed: ${F##*:}" | tee -a $LOG; }
  done
  return $RC
}

amend() {
  local KEY=$1 LOG=$LOG_DIR/$1.log WT=($REPOS/*/.worktrees/$1-*(N/[1])) BOX=$LOG_DIR/amend/$1 F
  [[ -f $SUSPECT/$KEY.md ]] || return 1
  echo "=== holdout amend $KEY $(date -Iseconds)" | tee -a $LOG
  rm -rf $BOX $PROPOSED/$KEY.md $PROPOSED/$KEY.api.md $PROPOSED/$KEY.why
  mkdir -p $BOX
  for F in $WT/TICKET.md:TICKET.md $WT/PLAN.md:PLAN.md $HOLDOUT/$KEY.md:holdout.md $HOLDOUT/$KEY.api.md:holdout.api.md \
      $LOG_DIR/$KEY.verify.md:verify.md $LOG_DIR/$KEY.verify-api.md:verify-api.md $SUSPECT/$KEY.md:suspect.md; do
    [[ -f ${F%:*} ]] && cp ${F%:*} $BOX/${F##*:}
  done
  (cd $BOX && claude -p "/cf-work-headless $KEY --holdout-amend" \
    --model sonnet --settings "$HEADLESS_SETTINGS" --strict-mcp-config --mcp-config '{"mcpServers":{}}' \
    --allowedTools "Read(./*) Edit(/$PROPOSED/$KEY.md) Edit(/$PROPOSED/$KEY.api.md) Edit(/$PROPOSED/$KEY.why) Skill" \
    --disallowedTools "Bash Agent WebFetch WebSearch Edit Read(/$REPOS/**) Read(/$TNOTES/**) Read(/$SUSPECT/**) Edit(/$HOLDOUT/**) Edit(/$REPOS/**) Edit(./**)" \
    --output-format stream-json --verbose </dev/null 2>>$LOG | stream >>$LOG)
  rm -rf $BOX $SUSPECT/$KEY.md
  [[ -f $PROPOSED/$KEY.md || -f $PROPOSED/$KEY.api.md ]]
}

proposal() { [[ -f $PROPOSED/$1.md || -f $PROPOSED/$1.api.md ]] }

after_amend() {
  limit_bail $1
  if amend $1; then
    note $1 "holdout change proposed, review in dash (A accept / X reject): $(paste -sd' ' $PROPOSED/$1.why 2>/dev/null)"
    return 0
  fi
  [[ -f $PROPOSED/$1.why ]] && { info $1 "scenario suspect rejected by analyzer: $(paste -sd' ' $PROPOSED/$1.why)"; rm -f $PROPOSED/$1.why }
  return 1
}

wm_window() {
  local WT=$1 LOG=$2
  tmux ls >/dev/null 2>&1 || return 0
  tmux has-session -t sw-factory 2>/dev/null || tmux new-session -d -s sw-factory -n log
  [[ -n $(tmux list-panes -s -t sw-factory -f "#{==:#{pane_current_path},$WT}" -F '#{pane_id}') ]] || tmux new-window -d -t sw-factory: -n ${WT:t} -c $WT "tail -n +1 -f --pid=$$ $LOG"
}

implement() {
  local KEY=$1 REPO=${2-} LOG=$LOG_DIR/$1.log
  echo "=== implement $KEY ($REPO) $(date -Iseconds)" | tee -a $LOG
  [[ -n "${3:-}" ]] && echo "  variant: ${3%% *}" >>$LOG
  [[ -n "$REPO" && -d $REPOS/$REPO/.git ]] || { echo "  no repo '$REPO'" | tee -a $LOG; return 1; }
  local SETUP=$(cd $REPOS/$REPO && cf-work $KEY --no-launch --comments-after $(<$HANDLED/$KEY 2>/dev/null || echo 0) 2>&1)
  echo "$SETUP" >>$LOG
  local WT=($REPOS/$REPO/.worktrees/${KEY}-*(N/[1]))
  local TIER=$(grep -oP 'claude --model \K\w+' <<<"$SETUP" || echo sonnet)
  local DIRS=(); for D in ${(u)${(f)"$(grep -oP -- '--add-dir \K\S+' <<<"$SETUP")"}}; do DIRS+=(--add-dir $D); done
  [[ -n "$WT" && -f $WT/PLAN.md ]] || { echo "  no worktree/PLAN.md" | tee -a $LOG; return 1; }
  wm_window $WT $LOG; local CR=($REPO) D
  for D in ${(u)${(f)"$(grep -oP -- '--add-dir \K\S+' <<<"$SETUP")"}}; do [[ $D == $REPOS/* ]] && CR+=(${${D#$REPOS/}%%/*}); done
  local CONV=$(conventions $KEY ${(j:,:)${(u)CR}}) CARGS=()
  [[ -n "$CONV" ]] && CARGS=(--append-system-prompt "$CONV")
  (cd $WT && BASH_MAX_TIMEOUT_MS=2700000 claude -p "/cf-ticket-headless $KEY ${3:-}" $CARGS \
    --model $TIER $DIRS --settings "$HEADLESS_SETTINGS" --strict-mcp-config --mcp-config "$(mcp_config $LOG_DIR/$KEY.layout-media lean-ctx codegraph)" \
    --allowedTools "Read Edit Write Skill Agent mcp__lean-ctx__ctx_read mcp__lean-ctx__ctx_search mcp__lean-ctx__ctx_glob mcp__lean-ctx__ctx_tree mcp__lean-ctx__ctx_compose mcp__codegraph__codegraph_explore mcp__playwright Bash(nr:*) Bash(pnpm:*) Bash(npx:*) Bash(git:*) Bash(glab mr create:*) Bash(glab mr list:*) Bash(glab mr view:*) Bash(glab api:*) Bash(jira:*) Bash(jq:*)" \
    --disallowedTools "Bash(git push --force:*) Bash(git push -f:*) Bash(git push origin develop:*) Bash(git push origin staging:*) Bash(git push origin production:*) Bash(git reset --hard:*) Bash(glab mr merge:*) Bash(glab mr approve:*) Edit(/$HOLDOUT/**) Write(/$HOLDOUT/**) Edit(/$PROPOSED/**) Write(/$PROPOSED/**)" \
    --output-format stream-json --verbose </dev/null 2>>$LOG | tee $LOG_DIR/$KEY.stream.jsonl | stream >>$LOG)
  local MR=$(cd $WT && glab mr list --source-branch "${WT:t}" -F json 2>/dev/null | jq -r '.[0].web_url // empty')
  [[ -n "$MR" ]] && echo "  mr -> $MR" | tee -a $LOG && echo "$MR" >$LOG_DIR/$KEY.mr
}

why() { [[ -n "${WHY:-}" ]] && echo "$1" >$WHY; return 2 }

cf_env() { TMPDIR=$HOME/cf-env-tmp $CF_ENV "$@" </dev/null }

ticket_env() {
  jira GET "/rest/api/3/issue/$1?fields=labels" | jq -r '[.fields.labels[] | select(startswith("env-")) | ltrimstr("env-")] | first // empty'
}

env_state() {
  local J
  J=$(glab api "projects/$ENVPROJ/environments?name=dynamic/$1" </dev/null 2>/dev/null) && jq -e 'type == "array"' <<<$J >/dev/null 2>&1 || { echo failed; return }
  jq -r 'if any(.[]; .state == "available") then "up" else "gone" end' <<<$J
}

verify_env() {
  local E=$(ticket_env $1) S
  [[ -n "$E" ]] || return 0
  S=$(env_state $E)
  [[ $S == failed ]] && { why "lookup failed: state of dyn-env $E"; return 2 }
  [[ $S == up ]] && echo $E
  return 0
}

env_unverify() {
  jira PUT "/rest/api/2/issue/$1" '{"update":{"labels":[{"remove":"ai-verified"},{"remove":"ai-verify-failed"},{"remove":"ai-verify-retry"}]}}' >/dev/null
}

env_reverify() {
  search 'project = DEV AND labels = ai-mr AND labels in (ai-verified, ai-verify-failed) AND statusCategory != Done AND status not in ("On nightly", "To test", "Release candidate", Rejected)' 50 \
    | jq -r '.issues[] | "\(.key) \([.fields.labels[] | select(startswith("env-")) | ltrimstr("env-")] | first // "")"' \
    | while read -r K E; do
        [[ "$E" == "$(cat $LOG_DIR/$K.verify-env 2>/dev/null)" ]] && continue
        if [[ -n "${TRIAGE_DRY:-}" ]]; then echo "would re-verify $K: env label '${E:-none}', verified on '$(cat $LOG_DIR/$K.verify-env 2>/dev/null)'"; continue; fi
        env_unverify $K </dev/null
        info $K "env label changed to '${E:-none}' since the last verify, verify labels dropped, re-verify next"
      done
}

env_push() {
  local KEY=$1 F=$LOG_DIR/$1.env-redeployed EN H S
  local WT=($REPOS/cf-farm-frontend/.worktrees/${KEY}-*(N/[1]))
  [[ -n "$WT" ]] || return 0
  H=$(git -C $WT rev-parse HEAD 2>/dev/null) || return 0
  [[ "$2" == *" $H"* || "$(cat $F 2>/dev/null)" == $H ]] && return 0
  EN=$(ticket_env $KEY)
  [[ -n "$EN" ]] || return 0
  S=$(env_state $EN)
  [[ $S == up ]] || { info $KEY "FE push ${H[1,10]}, dyn-env $EN $S, no redeploy"; return 0 }
  print -rl -- "RUN redeploy $EN FRONTEND=true FE_BRANCH=${WT:t}" $H >$LOG_DIR/$KEY.env-redeploy
  echo $H >$F
  info $KEY "FE push ${H[1,10]}, dyn-env $EN redeploy queued"
}

env_last_pipe() {
  glab api "projects/$ENVPROJ/deployments?environment=dynamic/$1&order_by=created_at&sort=desc&per_page=1" </dev/null 2>/dev/null \
    | jq -r '.[0] | select(.status == "success") | .deployable.pipeline.id // empty'
}

env_fe_fresh() {
  local P H WT=($REPOS/cf-farm-frontend/.worktrees/${1}-*(N/[1]))
  [[ -n "$WT" && -f $LOG_DIR/$1.env-fe ]] || return 1
  read -r P H <$LOG_DIR/$1.env-fe
  [[ -n $P && "$(git -C $WT rev-parse HEAD 2>/dev/null)" == $H && "$(env_last_pipe $2)" == $P ]]
}

env_say() {
  jira add-comment $1 "🤖 _${AI_MARK}. Píšu za Michala. Jestli se vám to nelíbí, dejte mi prosím vědět._
$2" >/dev/null </dev/null
}

env_resolve() {
  local KEY=$1 LOG=$LOG_DIR/$1.log OUT=$LOG_DIR/$1.env-cmd ASK=$LOG_DIR/$1.env-ask
  local WT=($REPOS/*/.worktrees/${KEY}-*(N/[1]))
  if [[ $2 == auto ]]; then cp $LOG_DIR/$KEY.env-req $ASK 2>/dev/null || : >$ASK
  else jira GET "/rest/api/2/issue/$KEY/comment/$2" | jq -r '.body // empty' >$ASK; fi
  rm -f $OUT
  [[ -s $ASK ]] || return 1
  (cd ${WT:-$LOG_DIR} && claude -p "/cf-env-resolve $KEY request=$ASK out=$OUT env=$(ticket_env $KEY) repos=$(ticket_repos $KEY) branch=${WT:t}" \
    --model sonnet --settings "$HEADLESS_SETTINGS" --strict-mcp-config --mcp-config "$(mcp_config '')" \
    --allowedTools "Read Skill Write(/$OUT) Bash(glab api:*) Bash(glab mr list:*) Bash($CF_ENV list) Bash($CF_ENV status:*) Bash($CF_ENV log:*) Bash(jq:*)" \
    --disallowedTools "$NO_SHIP $NO_REPO_WRITE Edit Bash(git:*) Bash($CF_ENV run:*) Bash(glab api -X:*) Bash(glab api --method:*) Read(/$HOLDOUT/**) Read(/$TNOTES/**) Read(/$SUSPECT/**) Read(/$PROPOSED/**)" \
    --output-format stream-json --verbose </dev/null 2>>$LOG | stream >>$LOG)
  [[ -s $OUT ]]
}

env_parse() {
  local W=(${=$(head -1 $1 2>/dev/null)}) A
  [[ ${W[1]:-} == RUN && ${W[2]:-} == (create|redeploy|destroy|wake|sleep|set-sleep|set-db-size|use) ]] || return 1
  [[ ${W[3]:-} =~ '^[a-z0-9-]{3,40}$' ]] || return 1
  for A in ${W[4,-1]}; do [[ $A =~ '^[A-Z_]+=[A-Za-z0-9_.:,/-]*$' ]] || return 1; done
  print -r -- ${W[2,-1]}
}

env_done() {
  local F EN R O
  for F in $ENVOWN/*(N); do
    [[ "$(<$F)" == $1 ]] || continue
    EN=${F:t}
    O=$(jql "labels = \"env-$EN\" AND statusCategory != Done AND key != $1" key 5 | jq -r '.issues | if type == "array" then (first.key // "") else error end') \
      || { note $1 "dyn-env \`$EN\`: lookup of other tickets on it failed, not destroyed, next Done check retries"; continue }
    if [[ -n $O ]]; then echo $O >$F; info $1 "ticket Done, dyn-env $EN kept: $O still uses it, now its owner"; continue; fi
    if R=$(cf_env run destroy $EN 2>&1) && [[ $R == pipeline\ * ]]; then rm -f $F; info $1 "ticket Done, dyn-env $EN destroy started: ${${=R}[3]}"
    else note $1 "dyn-env \`$EN\` destroy did not start, destroy it by hand: ${R[1,200]}"; fi
  done
}

env_gc() {
  local F K
  for F in $ENVOWN/*(N); do
    grep -qs " ${F:t} " $LOG_DIR/*.env-pipe(N) /dev/null && continue
    K=$(<$F)
    [[ "$(jira GET "/rest/api/2/issue/$K?fields=status" | jq -r '.fields.status.statusCategory.key // empty')" == done ]] && env_done $K
  done
}

SHIPPED_ST='"On nightly", "To test", "Release candidate", Rejected'
BLOCKERS_JQ='.fields.issuelinks[] | select(.type.inward == "is blocked by" and .inwardIssue != null) | .inwardIssue | select(.fields.status.statusCategory.key != "done" and ([.fields.status.name] | inside(["On nightly", "To test", "Release candidate", "Rejected"]) | not)) | .key'
blocked_by() {
  local J
  J=$(jira GET "/rest/api/2/issue/$1?fields=issuelinks") && jq -e '.fields.issuelinks' <<<$J >/dev/null || { echo "lookup failed"; return 0 }
  jq -r "$BLOCKERS_JQ" <<<$J | paste -sd, - | grep .
}
BE_MRS_JQ='.[] | select(.source_branch | ascii_downcase | . == $k or startswith($k + "-")) | select(.references.full | test("frontend!") | not) | "\(.state) \(.references.full | sub("!.*"; "") | split("/") | last)"'
ENV_PICK_JQ='.[] | .name | ltrimstr("dynamic/") as $n | select(any($ARGS.positional[]; . as $p | $n == $p or ($n | startswith($p + "-")))) | $n'

env_auto() {
  local KEY=$1 F=$LOG_DIR/$1.env-auto J EP D N L EN S="" T="" BR WT DEPS=() OPEN=() WAIT=() REQ=() ENVS=() FRESH
  local -A LBL
  J=$(jira GET "/rest/api/2/issue/$KEY?fields=labels,parent,issuelinks") && jq -e '.fields.labels' <<<$J >/dev/null || { why "lookup failed: deps of $KEY"; return 2 }
  jq -e '.fields.labels | any(startswith("env-"))' <<<$J >/dev/null && return 0
  FRESH=($F(Nmm-${ENV_AUTO_EVERY:-10}))
  [[ -f $F ]] && read -r S T <$F
  case $S in
    failed) return 0 ;;
    req) why "waiting for dyn-env ${T%% *} (create requested)"; return 2 ;;
    none) (( $#FRESH )) && return 0 ;;
    wait) (( $#FRESH )) && { why "$T"; return 2 } ;;
  esac
  WT=($REPOS/cf-farm-frontend/.worktrees/${KEY}-*(N/[1]))
  [[ -n "$WT" ]] || { why "no worktree in cf-farm-frontend"; return 2 }
  BR=${WT:t}
  EP=$(jq -r '.fields.parent.key // empty' <<<$J)
  DEPS=($(jq -r "$BLOCKERS_JQ" <<<$J))
  if [[ -n $EP ]]; then
    L=$(jql "parent = $EP AND key != $KEY AND statusCategory != Done AND status not in ($SHIPPED_ST)" key 100) && jq -e '.issues' <<<$L >/dev/null || { why "lookup failed: epic $EP children"; return 2 }
    DEPS+=($(jq -r '.issues[].key' <<<$L))
  fi
  for D in ${(u)DEPS}; do
    N=$(glab api "groups/cleverfarm%2Fcleverfarm/merge_requests?state=all&search=$D&per_page=100" </dev/null | jq -r --arg k ${D:l} "$BE_MRS_JQ") || { why "lookup failed: MRs of $D"; return 2 }
    if [[ $N == *opened\ * ]]; then
      OPEN+=($D)
      for S in ${(f)N}; do [[ $S == opened\ * ]] && REQ+=("${S#opened } z $D"); done
      REQ=(${(u)REQ})
    elif [[ $N == *merged\ * ]]; then
      WAIT+=($D)
    fi
  done
  if (( ! $#OPEN )); then
    [[ -n "${TRIAGE_DRY:-}" ]] && { echo "  env-auto $KEY: ${WAIT:+wait for }${WAIT:-no BE dependency}" >&2; (( $#WAIT )) && return 2 || return 0 }
    if (( $#WAIT )); then print -r -- "wait BE of ${(j:, :)WAIT} merged, not on nightly yet" >$F; why "BE of ${(j:, :)WAIT} merged, not on nightly yet"; return 2; fi
    echo none >$F
    return 0
  fi
  N=$(glab api "projects/$ENVPROJ/environments?search=dynamic/&states=available&per_page=100" </dev/null) && jq -e 'type == "array"' <<<$N >/dev/null || { why "lookup failed: dyn-envs"; return 2 }
  L=$(jql "key in (${(j:,:)OPEN})" labels 50) && jq -e '.issues' <<<$L >/dev/null || { why "lookup failed: labels of ${(j:,:)OPEN}"; return 2 }
  while read -r D S; do LBL[$D]=$S; done < <(jq -r '.issues[] | "\(.key) \([.fields.labels[] | select(startswith("env-"))] | join(" "))"' <<<$L)
  for D in ${(f)"$(jq -r '[.issues[].fields.labels[] | select(startswith("env-")) | ltrimstr("env-")] | unique | .[]' <<<$L)"}; do
    jq -e --arg n "dynamic/$D" 'any(.[]; .name == $n)' <<<$N >/dev/null && ENVS+=($D)
  done
  (( $#ENVS )) || ENVS=($(jq -r --args "$ENV_PICK_JQ" ${EP:l} ${OPEN:l} <<<$N | sort -u))
  if [[ -n "${TRIAGE_DRY:-}" ]]; then
    echo "  env-auto $KEY: BE ${(j:, :)OPEN} not on nightly → $(case $#ENVS in 1) echo "use $ENVS" ;; 0) echo "create ${${EP:-$OPEN[1]}:l}: ${(j:, :)REQ}" ;; *) echo "several fit: $ENVS" ;; esac)" >&2
    why "dry run: env-auto would act"
    return 2
  fi
  case $#ENVS in
    1)
      EN=$ENVS
      relabel $KEY "" env-$EN
      env_say $KEY "Frontend tohoto ticketu potřebuje backend z ${(j:, :)OPEN}, který ještě není na nightly, preview proti nightly by nestačilo. Ověření poběží na existujícím prostředí {{$EN}} (https://$EN.dev.cleverfarm.cz), štítek {{env-$EN}}. Při ověření do něj nasadím frontend z větve {{$BR}}, backend v něm nechám, jak je."
      for D in $OPEN $EP; do
        [[ $EN == ${D:l} || $EN == ${D:l}-* || " ${LBL[$D]:-} " == *" env-$EN "* ]] || continue
        env_say $D "Do prostředí {{$EN}} budu při ověření $KEY nasazovat frontend z větve {{$BR}}. Preview https://$EN.dev.cleverfarm.cz pak ukazuje tuhle větev místo dosavadního frontendu, backend nechávám beze změny."
      done
      rm -f $F
      info $KEY "env: auto use $EN (BE ${(j:,:)OPEN} not on nightly)"
      note $KEY "dyn-env \`$EN\` picked automatically: BE ${(j:, :)OPEN} not on nightly"
      return 0 ;;
    0)
      EN=${${EP:-$OPEN[1]}:l}
      print -r -- "env: nové prostředí $EN, ${(j:, :)REQ}, frontend z větve $BR" >$LOG_DIR/$KEY.env-req
      print -r -- "req $EN ${OPEN[*]}" >$F
      info $KEY "env: auto create $EN requested (BE ${(j:,:)OPEN} not on nightly, no env of theirs up)"
      why "waiting for dyn-env $EN (create requested)"
      return 2 ;;
    *)
      print -r -- "wait several dyn-envs fit (${(j:, :)ENVS}), pick one: env: použij <name>" >$F
      note $KEY "BE ${(j:, :)OPEN} not on nightly and several dyn-envs fit (${(j:, :)ENVS}): pick one with \`env: použij <name>\` in Jira"
      why "several dyn-envs fit (${(j:, :)ENVS}), pick one: env: použij <name>"
      return 2 ;;
  esac
}

verify_targets() {
  local KEY=$1 R WT MR PID IID PIPE SHA PS EN
  [[ -n "$2" ]] || { why "no repo-* label"; return 2 }
  if [[ ",$2," == *,cf-farm-frontend,* ]]; then env_auto $KEY || return 2; fi
  EN=$(verify_env $KEY) || return 2
  [[ -n "$EN" && ( -f $LOG_DIR/$KEY.env-redeploy || -f $LOG_DIR/$KEY.env-pipe ) ]] && { why "dyn-env $EN redeploy running"; return 2 }
  for R in ${(s:,:)2}; do
    WT=($REPOS/$R/.worktrees/${KEY}-*(N/[1]))
    [[ -n "$WT" ]] || { why "no worktree in $R"; return 2 }
    MR=$(cd $WT && glab mr list --source-branch "${WT:t}" -F json 2>/dev/null </dev/null | jq -c '.[0] // empty')
    [[ -n "$MR" ]] || { why "no open MR in $R"; return 2 }
    PID=$(jq -r .project_id <<<$MR) IID=$(jq -r .iid <<<$MR)
    PIPE=$(glab api "projects/$PID/merge_requests/$IID/pipelines" </dev/null | jq -c '.[0] // empty')
    PS=$(jq -r .status <<<$PIPE)
    [[ "$PS" == running ]] && glab api "projects/$PID/pipelines/$(jq -r .id <<<$PIPE)/jobs?per_page=100" </dev/null \
      | jq -e 'all(.[]; .status == "success" or .status == "manual" or .status == "skipped" or (.status == "failed" and .allow_failure))' >/dev/null && PS=success
    [[ "$PS" == success ]] || { why "pipeline ${PS:-missing} in $R, $(jq -r .web_url <<<$MR)"; return 2 }
    SHA=$(jq -r .sha <<<$PIPE)
    if [[ $2 == cf-farm-frontend && -z "$EN" ]] && ! grep -q '^NONE:' $HOLDOUT/$KEY.md 2>/dev/null && ! glab api --paginate "projects/$PID/merge_requests/$IID/notes?per_page=100" </dev/null \
        | jq -se --arg s "${SHA[1,8]}" 'add | any(.[]; (.body | contains("amplify-preview-url")) and (.body | contains("@ " + $s)))' >/dev/null; then
      AJ=($(glab api "projects/$PID/pipelines/$(jq -r .id <<<$PIPE)/jobs?per_page=100" </dev/null | jq -r '.[] | select(.name == "use Nightly backend") | "\(.id) \(.status) \(.web_url)"'))
      if [[ ${AJ[2]} != failed ]]; then
        why "Amplify preview note missing for ${SHA[1,8]} in $R"
      elif [[ "$(cat $LOG_DIR/$KEY.amplify-retry 2>/dev/null)" == ${SHA[1,8]} ]]; then
        why "Amplify preview job failed for ${SHA[1,8]} in $R, retry did not help, needs Michal: ${AJ[3]}"
      elif [[ -n "${TRIAGE_DRY:-}" ]]; then
        why "Amplify preview job failed for ${SHA[1,8]} in $R, would retry: ${AJ[3]}"
      elif glab api -X POST "projects/$PID/jobs/${AJ[1]}/retry" </dev/null >/dev/null; then
        echo ${SHA[1,8]} >$LOG_DIR/$KEY.amplify-retry
        why "Amplify preview job failed for ${SHA[1,8]} in $R, retried once: ${AJ[3]}"
      else
        why "Amplify preview job failed for ${SHA[1,8]} in $R, retry call failed: ${AJ[3]}"
      fi
      return 2
    fi
    echo "$R:$PID:$IID:$(jq -r .id <<<$PIPE):${SHA[1,8]}"
  done
}

verify_blocker() {
  local F=$(mktemp) BR
  if [[ ! -f $HOLDOUT/$1.md ]]; then
    echo "no holdout scenarios file"
  elif proposal $1; then
    echo "holdout proposal waiting for Michal (dash A/X)"
  elif unrunnable $1 >/dev/null; then
    echo "no holdout scenario can run ($(unrunnable $1))"
  elif BR=($LOG_DIR/$1.blocked-retry(Nmm-${BLOCKED_WAIT:-10})) && (( ${#BR} )); then
    echo "verify blocked by the environment, auto-retry $(<$BR)/${BLOCKED_MAX:-2} after ${BLOCKED_WAIT:-10} min"
  elif WHY=$F verify_targets $1 $2 >/dev/null </dev/null; then
    rm -f $F
    return 1
  else
    cat $F
  fi
  rm -f $F
}

stall_note() {
  local S=$STALLED/$1.since A=$STALLED/$1.alert NOW=$(date +%s)
  [[ -f $S ]] || { echo $NOW >$S; return }
  (( NOW - $(<$S) < ${STALL_HOURS:-4} * 3600 )) && return
  [[ -f $A ]] && (( NOW - $(<$A) < 86400 )) && return
  note $1 "ai-mr not verified for $(( (NOW - $(<$S)) / 3600 )) h: $2"
  echo $NOW >$A
}

verify() {
  local KEY=$1 KIND=${3:-ui} LOG=$LOG_DIR/$1.log WT0 T
  local OUT=$LOG_DIR/$KEY.verify$([[ $KIND == api ]] && echo -api).md SCEN=$HOLDOUT/$KEY$([[ $KIND == api ]] && echo .api).md
  local TARGETS=() WTA=() RS=(${(s:,:)2})
  [[ -f $SCEN ]] && ! proposal $KEY || return 2
  T=$(verify_targets $KEY $2) || return 2
  TARGETS=(${(f)T})
  WTA=($REPOS/${RS[1]}/.worktrees/${KEY}-*(N/[1]))
  [[ -n "$WTA" ]] || return 2
  WT0=$WTA
  local EL="" EN="" DEP=deploy=1
  if [[ $KIND == ui ]]; then
    EL=$(ticket_env $KEY)
    EN=$(verify_env $KEY) || return 2
    print -r -- "$EL" >$LOG_DIR/$KEY.verify-env
    [[ -n $EN && ${(j:,:)RS} == cf-farm-frontend ]] && env_fe_fresh $KEY $EN && DEP=deployed=1
  fi
  echo "=== verify-$KIND $KEY (${(j:, :)TARGETS}${EN:+, env $EN $DEP}) $(date -Iseconds)" | tee -a $LOG
  [[ -n "$EL" && -z "$EN" ]] && echo "  env $EL is gone, verifying as if the ticket had no env label" | tee -a $LOG
  local MEDIA=$LOG_DIR/$KEY.verify-media SKIP=$LOG_DIR/$KEY.data-skip
  rm -f $SKIP
  if [[ $KIND == ui ]]; then
    rm -f $UNVERIFIED/$KEY.md
    [[ -f $OUT && $OUT -nt $SCEN ]] && grep -E "$DATA_RE" $OUT >$SKIP
    [[ -s $SKIP ]] && echo "  skip (DATA last round, holdout unchanged): $(grep -oE '^S[0-9]+' $SKIP | paste -sd, -)" | tee -a $LOG || rm -f $SKIP
  fi
  rm -rf $OUT $MEDIA
  if [[ $KIND == ui && -z "$EN" && ${(j:,:)RS} == can-frontend ]] && ! grep -q '^NONE:' $SCEN; then
    { echo "VERDICT: unverified (can-frontend has no reachable preview)"
      sed -nE "$NOPREVIEW_SED" $SCEN } >$OUT
    grep -E '^S[0-9]+ ' $OUT >$UNVERIFIED/$KEY.md
    echo "  VERDICT: unverified (can-frontend has no reachable preview, verifier not started)" | tee -a $LOG
    return 0
  fi
  local MCP=$(mcp_config $MEDIA)
  wm_window $WT0 $LOG
  (cd $WT0 && TMPDIR=$HOME/cf-env-tmp claude -p "/cf-holdout-$KIND $KEY repos=${(j:,:)TARGETS} branch=${WT0:t}${EN:+ env=$EN $DEP}$([[ $KIND == ui ]] && echo " video=$MEDIA")${4:+ failed=$4}$([[ -s $SKIP ]] && echo " skip=$SKIP")" \
    --model sonnet --settings "$HEADLESS_SETTINGS" \
    --strict-mcp-config --mcp-config "$MCP" \
    --allowedTools "Read Skill Write(/$OUT) Write(/$MEDIA/narration.tsv) mcp__playwright Bash(glab mr note:*) Bash(glab api:*) Bash($CF_ENV:*) Bash(jq:*) Bash(curl:*) Bash(bash $HOME/.claude/skills/cf-holdout-ui/narrate.sh $MEDIA $KEY) Bash(bash $HOME/.claude/skills/cf-holdout-api/run-scenarios.sh:*)" \
    --disallowedTools "$NO_SHIP $NO_REPO_WRITE Edit Bash(git:*) Edit(/$HOLDOUT/**) Read(/$TNOTES/**) Read(/$SUSPECT/**) Read(/$PROPOSED/**)" \
    --output-format stream-json --verbose </dev/null 2>>$LOG | stream >>$LOG)
  local VERDICT=$(head -1 $OUT 2>/dev/null) U
  echo "  ${VERDICT:-no report}" | tee -a $LOG
  if [[ $KIND == ui && $VERDICT == "VERDICT: blocked"* ]] && U=$(data_only $OUT) && [[ -n $U ]]; then
    grep -E "$DATA_RE" $OUT >$UNVERIFIED/$KEY.md
    echo "  unverified: $U (blocked by missing data only, rest pass) → counts as verified, hand-check in quiz" | tee -a $LOG
    return 0
  fi
  case $VERDICT in
    "VERDICT: pass"*) return 0 ;;
    "VERDICT: fail"*) return 1 ;;
    "VERDICT: blocked"*) return 4 ;;
    *) return 3 ;;
  esac
}

mr_targets() {
  local KEY=$1 R WT MR
  [[ -n "$2" ]] || return 2
  for R in ${(s:,:)2}; do
    WT=($REPOS/$R/.worktrees/${KEY}-*(N/[1]))
    [[ -n "$WT" ]] || return 2
    MR=$(cd $WT && glab mr list --source-branch "${WT:t}" -F json 2>/dev/null </dev/null | jq -c '.[0] // empty')
    [[ -n "$MR" ]] || return 2
    echo "$R:$(jq -r .project_id <<<$MR):$(jq -r .iid <<<$MR)"
  done
}

gate_state() {
  local L=" $1 "
  if [[ " $2 " == *" ai-gate-skip "* ]]; then echo "success ai-gate-skip override"
  elif [[ $L == *" ai-verify-failed "* || $L == *" ai-review-findings "* || $L == *" ai-fix-failed "* ]]; then echo "failed factory needs Michal"
  elif [[ $L == *" ai-verified "* && $L == *" ai-reviewed "* && $L == *" ai-quizzed "* ]]; then echo "success verified + reviewed + quizzed"
  elif [[ $L == *" ai-verified "* && $L == *" ai-reviewed "* ]]; then echo "pending quiz Michal: factory-dash Q"
  else echo "pending factory verify/review in flight"
  fi
}

gate_sync() {
  local KEY=$1 R WT MR PID IID HP CUR WANT DESC MSG
  for R in ${(s:,:)2}; do
    WT=($REPOS/$R/.worktrees/${KEY}-*(N/[1]))
    [[ -n "$WT" ]] || continue
    MR=$(cd $WT && glab mr list --source-branch "${WT:t}" -F json 2>/dev/null </dev/null | jq -c '.[0] // empty')
    [[ -n "$MR" ]] || continue
    PID=$(jq -r .project_id <<<$MR) IID=$(jq -r .iid <<<$MR)
    HP=($(glab api "projects/$PID/merge_requests/$IID" </dev/null | jq -r '.head_pipeline // empty | "\(.id) \(.sha)"'))
    (( ${#HP} == 2 )) || { [[ -n "${GATE_VERBOSE:-}" ]] && echo "$KEY $R !$IID: no head pipeline"; continue }
    CUR=$(glab api "projects/$PID/repository/commits/${HP[2]}/statuses?name=cf-factory" </dev/null | jq -r 'max_by(.id) | .status // "none"')
    read -r WANT DESC <<<$(gate_state "$3" "$(jq -r '.labels | join(" ")' <<<$MR)")
    MSG="$KEY $R !$IID pipeline ${HP[1]}: gate $CUR → $WANT"
    if [[ $CUR == $WANT ]]; then
      [[ -n "${GATE_VERBOSE:-}" ]] && echo "$MSG (unchanged)"
      continue
    fi
    if [[ -n "${TRIAGE_DRY:-}" ]]; then echo "would set $MSG"; continue; fi
    if glab api -X POST "projects/$PID/statuses/${HP[2]}" -f state=$WANT -f name=cf-factory -f pipeline_id=${HP[1]} \
      -f description="$DESC" -f target_url="https://cleverfarm.atlassian.net/browse/$KEY" </dev/null >/dev/null 2>$LOG_DIR/.gate-err; then
      echo "$(date '+%T') $MSG" | tee -a $LOG_DIR/$KEY.log
    else
      echo "$(date '+%T') $MSG failed: $(<$LOG_DIR/.gate-err)" | tee -a $LOG_DIR/$KEY.log
    fi
  done
}

GATE_JQ='.issues[] | "\(.key) \(.fields.labels | map(select(startswith("repo-")) | ltrimstr("repo-")) | join(",") | if . == "" then "-" else . end) \(.fields.labels | join(" "))"'

gate_all() {
  search "$1" 50 | jq -r "$GATE_JQ" | while read -r K R L; do gate_sync $K $R "$L" </dev/null; done
}

ticket_repos() {
  jira GET "/rest/api/3/issue/$1?fields=labels" | jq -r '[.fields.labels[] | select(startswith("repo-")) | ltrimstr("repo-")] | join(",")'
}

gl_human_max() {
  local T L P ID=0 N
  T=$(mr_targets $1 $2) || return 1
  GLME=${GLME:-$(glab api user </dev/null | jq -r .username)}
  [[ -n "$GLME" ]] || return 1
  for L in ${(f)T}; do
    P=(${(s.:.)L})
    N=$(glab api --paginate "projects/${P[2]}/merge_requests/${P[3]}/notes?per_page=100" </dev/null \
      | jq -sr --arg me "$GLME" "$GL_PINGED"'add | [.[] | select((.system | not) and .author.username == $me and (.body | contains("writing on Michal") | not) and (pinged | not)) | .id] | max // 0') || return 1
    (( N > ID )) && ID=$N
  done
  echo $ID
}

gl_unanswered() {
  local T L P ID="" N H=$(<$GLHANDLED/$1 2>/dev/null || echo 0)
  T=$(mr_targets $1 $2) || return 1
  GLME=${GLME:-$(glab api user </dev/null | jq -r .username)}
  [[ -n "$GLME" ]] || return 1
  for L in ${(f)T}; do
    P=(${(s.:.)L})
    N=$(glab api --paginate "projects/${P[2]}/merge_requests/${P[3]}/discussions?per_page=100" </dev/null \
      | jq -sr --arg me "$GLME" --argjson h "${H:-0}" "$GL_PINGED"'add | [.[] | [.notes[] | select((.system | not) and .author.username == $me)] as $n
          | ([$n[] | select(.body | startswith("🤖")) | .id] | max // 0) as $b
          | $n[] | select((.body | startswith("🤖") or contains("writing on Michal") | not) and (pinged | not) and .id > ([$b, $h] | max)) | .id] | min // empty') || return 1
    [[ -n "$N" ]] && (( ! ID || N < ID )) && ID=$N
  done
  echo $ID
}

gl_pending() {
  [[ -n "$(gl_unanswered $1 $2 </dev/null)" ]]
}

gl_event_keys() {
  local EV P I N K B H M=$LOG_DIR/.gl-mr-keys
  GLME=${GLME:-$(glab api user </dev/null | jq -r .username)}
  [[ -n "$GLME" ]] || return 1
  EV=$(glab api "events?action=commented&after=$(date -d '4 days ago' +%F)&per_page=100" </dev/null) || return 1
  touch $M
  jq -r --arg me "$GLME" "$GL_PINGED"'.[] | select(.note.noteable_type == "MergeRequest" and (.note.system | not))
      | select((.note.body | startswith("🤖") or contains("writing on Michal") | not) and (.note | pinged | not))
      | "\(.project_id) \(.note.noteable_iid) \(.note.id)"' <<<$EV \
    | while read -r P I N; do
      K=$(awk -v k="$P:$I" '$1 == k { print $2; exit }' $M)
      if [[ -z $K ]]; then
        B=$(glab api "projects/$P/merge_requests/$I" </dev/null) || continue
        K=$(jq -r '.source_branch // empty' <<<$B | grep -oiP '^dev-\d+')
        K=${${K:u}:--}
        echo "$P:$I $K" >>$M
      fi
      [[ $K == - ]] && continue
      H=0
      [[ -f $GLHANDLED/$K ]] && H=$(<$GLHANDLED/$K)
      (( N > H )) && echo $K
    done | sort -u
}

conv_add() { CONV_L+=("$1"); CONV_B+=("$2"); CONV_N+=("$3"); CONV_S+=($(print -rn -- "$2" | wc -c)); }

conv_collect() {
  local KEY=$1 R=$2 WT=$3 LOG=$LOG_DIR/$1.log BASE C F P d
  BASE=$(cd $WT && glab mr list --source-branch "${WT:t}" -F json 2>/dev/null </dev/null | jq -r '.[0].target_branch // empty')
  [[ -n "$BASE" ]] || BASE=$(git -C $WT symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)
  BASE=${BASE#origin/}
  [[ -n "$BASE" ]] || { echo "  conventions: no base branch in $R" >>$LOG; return }
  git -C $WT fetch -q origin $BASE </dev/null 2>/dev/null
  F=.claude/skills/review-checklist/SKILL.md
  C=$(git -C $WT show origin/$BASE:$F 2>/dev/null) && conv_add "$R/$F" "$C" 0
  P=(${(f)"$(git -C $WT diff --name-only origin/$BASE...HEAD 2>/dev/null)"}
     ${(f)"$(sed -n '/^### Change map/,/^#/p' $WT/PLAN.md 2>/dev/null | grep -oP '`\K[^`\s]+(?=`)' | grep -E '/|\.[a-z]+$')"})
  local DIRS=(${(f)"$(for F in $P; do d=${F:h}; while [[ $d != . && $d != / && -n $d ]]; do echo $d; d=${d:h}; done; done | sort -u | awk '{print gsub("/","/") " " $0}' | sort -n | cut -d' ' -f2-)"})
  for d in $DIRS; do
    C=$(git -C $WT show origin/$BASE:$d/CLAUDE.md 2>/dev/null) && conv_add "$R/$d/CLAUDE.md" "$C" 1
  done
}

conventions() {
  local KEY=$1 LOG=$LOG_DIR/$1.log R WT i TOTAL=0 DROP=()
  CONV_L=() CONV_B=() CONV_N=() CONV_S=()
  for R in ${(s:,:)2}; do
    WT=($REPOS/$R/.worktrees/${KEY}-*(N/[1]))
    [[ -n "$WT" ]] && conv_collect $KEY $R $WT
  done
  for i in ${CONV_S}; do (( TOTAL += i )); done
  while (( TOTAL > 100000 )); do
    i=${CONV_N[(I)1]}
    (( i )) || break
    (( TOTAL -= CONV_S[i] )); DROP+=($CONV_L[i])
    CONV_L[i]=() CONV_B[i]=() CONV_N[i]=() CONV_S[i]=()
  done
  for i in {1..$#CONV_L}; do
    print -r -- "<conventions file=\"$CONV_L[i]\">"
    print -r -- "$CONV_B[i]"
    print -r -- "</conventions>"
  done
  echo "  conventions: $#CONV_L files, $TOTAL B: ${(j:, :)CONV_L}" >>$LOG
  (( $#DROP )) && echo "  conventions dropped (over 100 KB): ${(j:, :)DROP}" >>$LOG
  return 0
}

review() {
  local KEY=$1 LOG=$LOG_DIR/$1.log OUT=$LOG_DIR/$1.review.md T WT0 WTA=() RS=(${(s:,:)2})
  T=$(mr_targets $KEY $2) || return 2
  WTA=($REPOS/${RS[1]}/.worktrees/${KEY}-*(N/[1]))
  [[ -n "$WTA" ]] || return 2
  WT0=$WTA
  local PRIOR=""
  if [[ -n "${3:-}" ]]; then
    cp -f $OUT $LOG_DIR/$KEY.review.prev.md
    PRIOR=" prior=$LOG_DIR/$KEY.review.prev.md since=${(j:,:)${${(f)3}// /@}}"
  fi
  echo "=== review${PRIOR:+ (incremental)} $KEY (${(j:, :)${(f)T}}) $(date -Iseconds)" | tee -a $LOG
  rm -f $OUT
  wm_window $WT0 $LOG; local CONV=$(conventions $KEY $2) CARGS=()
  [[ -n "$CONV" ]] && CARGS=(--append-system-prompt "$CONV")
  (cd $WT0 && claude -p "/cf-review $KEY repos=${(j:,:)${(f)T}} branch=${WT0:t} report=$OUT$PRIOR" $CARGS \
    --model opus --settings "$HEADLESS_SETTINGS" --strict-mcp-config --mcp-config "$(mcp_config '' lean-ctx codegraph)" \
    --allowedTools "Read Skill Agent mcp__lean-ctx__ctx_read mcp__lean-ctx__ctx_search mcp__lean-ctx__ctx_glob mcp__lean-ctx__ctx_tree mcp__lean-ctx__ctx_compose mcp__codegraph__codegraph_explore Write(/$OUT) Bash(git diff:*) Bash(git log:*) Bash(git show:*) Bash(git blame:*) Bash(git merge-base:*) Bash(git fetch:*) Bash(glab mr note:*) Bash(glab api:*) Bash(jq:*)" \
    --disallowedTools "$NO_SHIP $NO_REPO_WRITE Edit Bash(git push:*) Bash(git commit:*) Bash(git checkout:*) Bash(git reset:*) Bash(pnpm:*) Bash(nr:*) Bash(npx:*) Read(/$HOLDOUT/**) Read(/$TNOTES/**) Read(/$SUSPECT/**) Read(/$PROPOSED/**)" \
    --output-format stream-json --verbose </dev/null 2>>$LOG | stream >>$LOG)
  local VERDICT=$(head -1 $OUT 2>/dev/null)
  echo "  ${VERDICT:-no report}" | tee -a $LOG
  [[ -f $OUT ]] && echo "  findings: $(awk '/^## must-fix/{s="m";next} /^## should-fix/{s="s";next} /^## /{s=""} /^[0-9]+\. /{cur=($0 !~ /\[(fixed|dropped)\]/); if (cur) c[s]++} /^ +- Rule:/{if (cur) r++} END{printf "must=%d should=%d convention=%d", c["m"], c["s"], r}' $OUT)" >>$LOG
  case $VERDICT in
    "VERDICT: clean"*) return 0 ;;
    "VERDICT: minor"*) return 1 ;;
    "VERDICT: blocking"*) return 4 ;;
    *) return 3 ;;
  esac
}

conflicts() {
  glab api "merge_requests?scope=created_by_me&state=opened&per_page=100" | jq -r '.[] | "\(.project_id) \(.iid)"' \
    | while read -r PID IID; do
        glab api "projects/$PID/merge_requests/$IID?with_merge_status_recheck=true" </dev/null \
          | jq -r 'select(.has_conflicts) | "\(.project_id) \(.iid) \(.references.full | sub("!.*"; "") | split("/") | last) \(.source_branch) \(.target_branch) \(.draft) \(.labels | index("ai-rebase") != null) \(.web_url)"'
      done
}

rebasing() { (cd $1 && [[ -d $(git rev-parse --git-path rebase-merge) ]]) }

lock_resolve() {
  local WT=$1 U REST
  while rebasing $WT; do
    U=(${(f)"$(git -C $WT diff --name-only --diff-filter=U)"})
    REST=(${U:#*pnpm-lock.yaml})
    (( ${#U} && ! ${#REST} )) || return 1
    git -C $WT checkout -q --ours -- $U
    (cd $WT && pnpm install --lockfile-only </dev/null >/dev/null 2>&1) || return 1
    git -C $WT add -- $U
    GIT_EDITOR=true git -C $WT rebase --continue >/dev/null 2>&1
  done
  return 0
}

conflict_state() {
  local GIT=$1 TGT=$2 BR=$3 DRAFT=$4 GO=$5
  [[ -d $GIT/.git ]] || { echo norepo; return }
  git -C $GIT fetch -q origin $TGT $BR || return 1
  echo "$(git -C $GIT rev-parse origin/$BR) $DRAFT $GO"
}

conflict_due() {
  local PID=$1 IID=$2 R=$3 BR=$4 TGT=$5 DRAFT=$6 GO=$7 STATE
  STATE=$(conflict_state $REPOS/$R $TGT $BR $DRAFT $GO) || return 1
  [[ "$(cat $LOG_DIR/conflicts/$PID-$IID 2>/dev/null)" != "$STATE" ]]
}

resolve_conflict() {
  local PID=$1 IID=$2 R=$3 BR=$4 TGT=$5 DRAFT=$6 GO=$7 URL=$8
  local GIT=$REPOS/$R KEY=${$(grep -oiP '^dev-\d+' <<<$BR):u} MARK=$LOG_DIR/conflicts/$1-$2
  local LOG=$LOG_DIR/${KEY:-$BR}.log REPORT=$MARK.md WHO="$URL (${KEY:-$BR})"
  local OLD STATE
  STATE=$(conflict_state $GIT $TGT $BR $DRAFT $GO) || return
  [[ $STATE == norepo ]] || OLD=${STATE%% *}
  [[ "$(cat $MARK 2>/dev/null)" == "$STATE" ]] && return
  echo $STATE >$MARK
  [[ $STATE == norepo ]] && { echo "$WHO conflicts, no local repo $R" >>$NOTES; return }
  echo "=== conflict $URL onto $TGT $(date -Iseconds)" | tee -a $LOG
  local GATED=false
  [[ $DRAFT != true || -n "$(glab api projects/$PID/merge_requests/$IID/approvals | jq -r '.approved_by[]?')" ]] && [[ $GO != true ]] && GATED=true
  if git -C $GIT log --format=%ae origin/$TGT..origin/$BR | grep -qvxF "$(git -C $GIT config user.email)"; then
    echo "$WHO conflicts with $TGT, has others' commits → resolve by hand" >>$NOTES; return
  fi
  local BOTH=$(comm -12 <(git -C $GIT diff --name-only origin/$TGT...origin/$BR | sort) <(git -C $GIT diff --name-only origin/$BR...origin/$TGT | sort) | wc -l)
  if (( BOTH > ${CONFLICT_MAX_FILES:-10} )); then
    echo "$WHO conflicts with $TGT, $BOTH files changed on both sides → resolve interactively" >>$NOTES; return
  fi
  local WT=$(git -C $GIT worktree list --porcelain | awk -v b="branch refs/heads/$BR" '/^worktree /{p=substr($0,10)} $0==b{print p}')
  if [[ -z "$WT" ]]; then
    WT=$GIT/.worktrees/$BR
    git -C $GIT worktree add -q $WT $BR 2>/dev/null || git -C $GIT worktree add -q -b $BR $WT origin/$BR || return
  fi
  if [[ -n "$(git -C $WT status --porcelain -uno)" || "$(git -C $WT rev-parse HEAD)" != $OLD ]]; then
    echo "$WHO conflicts with $TGT, worktree \`$WT\` dirty or differs from origin → resolve by hand" >>$NOTES; return
  fi
  rm -f $REPORT
  local HOW="clean rebase"
  git -C $WT rebase -q origin/$TGT >>$LOG 2>&1 || HOW="lockfile regenerated"
  if [[ $HOW != "clean rebase" ]] && ! lock_resolve $WT; then
    if [[ $GATED == true ]]; then
      git -C $WT rebase --abort
      echo "  code conflict, MR under review → waiting for ai-rebase" | tee -a $LOG
      echo "$WHO conflicts with $TGT in code, under review → add MR label \`ai-rebase\` to resolve" >>$NOTES; return
    fi
    wm_window $WT $LOG
    (cd $WT && claude -p "Rebase of branch $BR onto origin/$TGT is in progress in this worktree and stopped on conflicts. No human present, never ask. Run /mattpocock-skills:resolving-merge-conflicts. Intent of this branch: its MR $URL + PLAN.md / TICKET.md here if present. Intent of the other side: the commits on origin/$TGT touching each conflicted file (git log origin/$TGT -- <file>) and their MRs (glab api). Keep both intents. pnpm-lock.yaml: never hand-merge, git checkout --ours it, then pnpm install --lockfile-only. Continue with GIT_EDITOR=true git rebase --continue until the rebase is finished. Then run the repo's lint, typecheck and the tests touching the conflicted files (per its CLAUDE.md), fix only what the resolution broke, amend into the rebased commits. Never push, never skip or drop commits. Not confident about a hunk → stop. Write $REPORT: first line exactly RESOLVED or FAILED: <reason>, then markdown bullets for a reviewer skimming an MR note, one per conflicted file: - \`<path>\`: kept <X>, dropped <Y>, <why in one short clause> (max 2 lines each, no paragraphs). If the resolution forced a follow-up edit in a file that did not conflict, one more bullet for it. Last bullet: - Checks: <what ran, result>." \
      --model opus --settings "$HEADLESS_SETTINGS" --strict-mcp-config --mcp-config "$(mcp_config '' lean-ctx codegraph)" \
      --allowedTools "Read Edit Write Skill mcp__lean-ctx__ctx_read mcp__lean-ctx__ctx_search mcp__lean-ctx__ctx_glob mcp__lean-ctx__ctx_tree mcp__lean-ctx__ctx_compose mcp__codegraph__codegraph_explore Bash(git:*) Bash(pnpm:*) Bash(nr:*) Bash(npx:*) Bash(glab api:*) Bash(glab mr view:*) Bash(jq:*)" \
      --disallowedTools "Bash(git push:*) Bash(git reset --hard:*) Bash(git rebase --skip:*) Bash(git rebase --abort:*) Bash(glab mr merge:*) Bash(glab mr approve:*) Edit(/$HOLDOUT/**) Write(/$HOLDOUT/**) Edit(/$PROPOSED/**) Write(/$PROPOSED/**)" \
      --output-format stream-json --verbose </dev/null 2>>$LOG | stream >>$LOG)
    if rebasing $WT || [[ "$(head -1 $REPORT 2>/dev/null)" != RESOLVED ]]; then
      rebasing $WT && git -C $WT rebase --abort
      echo "  conflict resolve failed: $(head -1 $REPORT 2>/dev/null)" | tee -a $LOG
      echo "$WHO conflict resolve failed: $(head -1 $REPORT 2>/dev/null || echo 'no report'), see \`$LOG\`" >>$NOTES; return
    fi
    HOW=$(tail -n +2 $REPORT | sed -E '/^[[:space:]]*$/d; /^[[:space:]]*[-*] /!s/^/- /')
  fi
  if [[ $(git -C $WT rev-list --count origin/$TGT..HEAD) != $(git -C $GIT rev-list --count origin/$TGT..$OLD) ]]; then
    git -C $WT reset -q --hard $OLD
    echo "$WHO rebase dropped commits, not pushed, reset to $OLD → resolve by hand" >>$NOTES; return
  fi
  git -C $WT push -q --force-with-lease=$BR:$OLD origin HEAD:$BR >>$LOG 2>&1 || { echo "$WHO resolved but push rejected, see \`$LOG\`" >>$NOTES; return }
  [[ $GO == true ]] && glab api -X PUT projects/$PID/merge_requests/$IID -f remove_labels=ai-rebase >/dev/null
  glab api -X POST projects/$PID/merge_requests/$IID/notes -f body="🤖 _I'm writing on Michal's behalf. If you don't like it, please let me know._

Rebased onto \`$TGT\`, conflicts resolved:

$HOW${${GATED:#false}:+

No code changed: git applied every commit as is, only \`pnpm-lock.yaml\` was regenerated if it conflicted. Existing approvals stay valid.}" >/dev/null
  echo "  rebased + pushed" | tee -a $LOG
  if [[ $HOW != (clean\ rebase|lockfile\ regenerated) && -n "$KEY" ]] && search "key = $KEY AND labels in (ai-verified, ai-reviewed, ai-quizzed)" 1 | jq -e '.issues | length > 0' >/dev/null; then
    jira PUT "/rest/api/2/issue/$KEY" '{"update":{"labels":[{"remove":"ai-verified"}]}}' >/dev/null
    unreview $KEY
    rm -f $UNVERIFIED/$KEY.md $LOG_DIR/$KEY.reviewed
    echo "  info: $WHO rebased, conflicts resolved by agent, ai-verified / ai-reviewed / ai-quizzed dropped, holdout re-verify + full review queued" >>$LOG
  else
    echo "  info: $WHO rebased onto $TGT (${${HOW%%$'\n'*}#- })" >>$LOG
  fi
}

ROWS_JQ='.issues[] | "\(.key) \((.fields.labels | map(select(startswith("repo-"))) | sort_by(. != "repo-cf-farm-frontend") | first // "repo-") | ltrimstr("repo-"))"'
REPOS_JQ='.issues[] | "\(.key) \(.fields.labels | map(select(startswith("repo-")) | ltrimstr("repo-")) | sort_by(. != "cf-farm-frontend") | join(","))"'

stage_new() {
  local ID=$(snap_human $1)
  if analyze $1 ${2-}; then
    mark_handled $1 $ID
    if [[ "$(grill_outcome $1)" == ASK ]]; then grill_bump $1; relabel $1 triage needs-answer; note $1 "questions posted, \`needs-answer\` (round $(<$LOG_DIR/$1.round)), reply in Jira"
    else relabel $1 triage triaged; note $1 "triaged, PLAN.md ready (add \`ai-fix\` to implement)"; fi
  else relabel $1 triage triage-failed; note $1 "triage failed, see \`$LOG_DIR/$1.log\`"; fi
}

stage_reply() {
  echo "--- follow-up $1"
  has_label $1 ai-mr && { echo "  already ai-mr (stale search index), left for MR follow-up"; return 0 }
  local ID=$(snap_human $1) CUR=triaged
  [[ -n "${GRILL:-}" ]] && has_label $1 needs-answer && CUR=needs-answer
  if analyze $1 ${2-}; then
    mark_handled $1 $ID
    if [[ "$(grill_outcome $1)" == ASK ]]; then
      grill_bump $1
      [[ $CUR == triaged ]] && relabel $1 triaged needs-answer
      note $1 "your reply answered, more questions (round $(<$LOG_DIR/$1.round)), reply in Jira"
    else
      [[ -n "${GRILL:-}" ]] && has_label $1 ai-fix-failed && unlabel $1 ai-fix-failed
      if [[ $CUR == needs-answer ]]; then relabel $1 needs-answer triaged; note $1 "questions settled, PLAN.md ready (add \`ai-fix\` to implement)"
      else info $1 "your reply answered"; fi
    fi
  else relabel $1 $CUR triage-failed; note $1 "reply follow-up failed, parked as \`triage-failed\` (re-add \`triage\` to retry), see \`$LOG_DIR/$1.log\`"; fi
}

close_bot_mr() {
  local L=$(jira GET "/rest/api/2/issue/$1?fields=labels" | jq -r '[.fields.labels[] | select(startswith("dependabot-"))] | first // empty')
  [[ -n "$L" ]] || return 0
  local IID=${L##*-} R=${${L#dependabot-}%-*}
  if (cd $REPOS/$R && glab api -X POST "projects/:id/merge_requests/$IID/notes" -f body="🤖 _I'm writing on Michal's behalf. If you don't like it, please let me know._

Superseded by $(cat $LOG_DIR/$1.mr) ($1)." >/dev/null && glab api -X PUT "projects/:id/merge_requests/$IID" -f state_event=close >/dev/null) </dev/null; then
    info $1 "dependabot MR $R!$IID closed, superseded by $(cat $LOG_DIR/$1.mr)"
  else
    note $1 "closing dependabot MR $R!$IID failed, close it by hand"
  fi
}

stage_impl() {
  local ID=$(snap_human $1) S=$(snap_all $1) U
  if [[ ! -f $LOG_DIR/$1.blind ]] && U=$(unrunnable $1); then
    echo "=== implement $1 refused: no holdout scenario can run ($U)" | tee -a $LOG_DIR/$1.log
    relabel $1 ai-fix triaged
    note $1 "not implementing: no holdout scenario can run, nobody would see the UI before you ($U). Fix the fixture / env and reply in Jira, or accept blind: \`touch $LOG_DIR/$1.blind\` + re-add \`ai-fix\`"
    return 0
  fi
  if implement $1 ${2-}; then mark_handled $1 $ID; relabel $1 ai-fix ai-mr; info $1 "draft MR: $(cat $LOG_DIR/$1.mr)"; if has_label $1 deps; then close_bot_mr $1; fi; elif search "key = $1 AND status = Done" 1 | jq -e '.issues | length > 0' >/dev/null; then relabel $1 ai-fix triaged; info $1 "already fixed, closed as duplicate, Sentry resolves next run"; else fallback_comment $1 $S; relabel $1 ai-fix ai-fix-failed; note $1 "ai-fix failed / bailed out, see Jira comment + \`$LOG_DIR/$1.log\`"; fi
}

wt_heads() {
  local W
  for W in $REPOS/*/.worktrees/$1-*(N/); do echo "${W:t} $(git -C $W rev-parse HEAD 2>/dev/null)"; done
}

running_mark() {
  local M=$LOG_DIR/running/$2
  mkdir -p $LOG_DIR/running
  wt_heads $2 >$M.heads
  echo "$(date +%s) $1 $(snap_human $2) $(gl_human_max $2 "$(ticket_repos $2)" </dev/null || echo 0) $(wc -l <$LOG_DIR/$2.log 2>/dev/null || echo 0)" >$M
}

POSTED_RE='glab mr note [^l]|-X (POST|PUT)|--method (POST|PUT)|jira (POST|PUT)|git (commit|push)'

restart_young() {
  local S=$1 KEY=$2 U=$3 M=$LOG_DIR/running/$2 T RS J G N W NOW=$(date +%s)
  [[ $S == (mr|reply) && -f $M ]] || return 1
  read -r T RS J G N <$M
  [[ $RS == (mr|impl) && $U == sw-factory-$KEY-$RS.service ]] || return 1
  (( NOW - T < ${RESTART_WINDOW:-5} * 60 )) || return 1
  [[ "$(wt_heads $KEY)" == "$(<$M.heads)" ]] || return 1
  tail -n +$(( ${N:-0} + 1 )) $LOG_DIR/$KEY.log | grep -qE "$POSTED_RE" && return 1
  (( ${$(snap_human $KEY):-0} > ${J:-0} )) || (( ${$(gl_human_max $KEY "$(ticket_repos $KEY)" </dev/null):-0} > ${G:-0} )) || return 1
  [[ -n "${TRIAGE_DRY:-}" ]] && { echo "would restart $U (new comment $(( NOW - T )) s in)"; return 0 }
  systemctl --user stop $U
  for W in $REPOS/*/.worktrees/$KEY-*(N/); do
    [[ -n "$(git -C $W status --porcelain)" ]] && git -C $W stash push -u -q -m "sw-factory restart $(date -Iseconds)"
  done
  [[ "$(wt_heads $KEY)" == "$(<$M.heads)" ]] || unverify $KEY
  rm -f $M $M.heads
  echo "$(date '+%T') restart: new comment $(( NOW - T )) s into $RS, stopped (uncommitted work stashed), all comments next tick" | tee -a $LOG_DIR/$KEY.log
}

unreview() {
  limit_bail $1
  jira PUT "/rest/api/2/issue/$1" '{"update":{"labels":[{"remove":"ai-reviewed"},{"remove":"ai-quizzed"}]}}' >/dev/null
}

unverify() {
  limit_bail $1
  jira PUT "/rest/api/2/issue/$1" '{"update":{"labels":[{"remove":"ai-verified"},{"remove":"ai-verify-failed"},{"remove":"ai-verify-retry"}]}}' >/dev/null
  unreview $1
  rm -f $UNVERIFIED/$1.md
}

stage_mr() {
  echo "--- MR follow-up $1"
  local ID=$(snap_human $1) S=$(snap_all $1) H0=$(wt_heads $1) RS=$(ticket_repos $1)
  local GLID=$(gl_human_max $1 $RS </dev/null) U=$(gl_unanswered $1 $RS </dev/null) AFTER=$(<$GLHANDLED/$1 2>/dev/null || echo 0)
  [[ -n "$U" ]] && AFTER=$(( U - 1 ))
  implement $1 ${2-} "--mr-notes-after $AFTER"
  env_push $1 "$H0"
  after_amend $1
  if answered_since $1 $S; then
    mark_handled $1 $ID
    [[ -n "$GLID" ]] && echo $GLID >$GLHANDLED/$1
    if [[ "$(wt_heads $1)" != "$H0" ]]; then unverify $1; info $1 "your reply answered on MR, new commits pushed, verify labels dropped, re-verify next: $(cat $LOG_DIR/$1.mr)"; else info $1 "your reply answered on MR: $(cat $LOG_DIR/$1.mr)"; fi
  elif fallback_comment $1 $S; then mark_handled $1 $ID; note $1 "MR follow-up stuck, its conclusion posted to Jira, reply there: $(cat $LOG_DIR/$1.mr)"
  else relabel $1 ai-mr ai-fix-failed; note $1 "MR follow-up failed, see \`$LOG_DIR/$1.log\`"; fi
}

stale_verify() {
  [[ "$(wt_heads $1)" == "$2" ]] && return 1
  rm -f $UNVERIFIED/$1.md
  echo "  stale: commits moved during verify (MR follow-up), result dropped, labels untouched" | tee -a $LOG_DIR/$1.log
}

failed_scenarios() { sed -nE 's/^(S[0-9]+) [^—]*: fail.*/\1/p' $1 2>/dev/null | paste -sd, - }

blocked_retry() {
  local F=$LOG_DIR/$1.blocked-retry N=0
  [[ -f $F ]] && N=$(<$F)
  unrunnable $1 >/dev/null && return 1
  grep -qE '^S[0-9]+ [^—]*: (pass|fail)' $2 2>/dev/null && return 1
  (( N >= ${BLOCKED_MAX:-2} )) && return 1
  echo $(( N + 1 )) >$F
  echo "  blocked-retry: $(( N + 1 ))/${BLOCKED_MAX:-2}" >>$LOG_DIR/$1.log
}

stage_verify() {
  local KEY=$1 REPO=$2 RC H0 FAILED="" REPORT=$LOG_DIR/$1.verify.md VH=$(wt_heads $1) LK
  has_label $KEY ai-verified ai-verify-failed ai-review-retry && { echo "  already verified or in rfix (stale search index), skipped"; return 0 }
  has_label $KEY ai-verify-retry && FAILED=$(failed_scenarios $REPORT)
  verify $KEY $REPO ui "$FAILED"
  RC=$?
  (( RC == 2 )) && return 2
  stale_verify $KEY "$VH" && return 0
  if (( RC == 4 )) && blocked_retry $KEY $REPORT; then return 0; fi
  rm -f $LOG_DIR/$KEY.blocked-retry
  if (( RC == 0 )) && [[ -f $HOLDOUT/$KEY.api.md ]]; then
    REPORT=$LOG_DIR/$KEY.verify-api.md
    verify $KEY $REPO api
    RC=$?
    (( RC == 2 )) && return 2
    stale_verify $KEY "$VH" && return 0
  fi
  if (( RC == 0 )); then
    relabel $KEY ai-verify-retry ai-verified
    if [[ -s $UNVERIFIED/$KEY.md ]]; then
      info $KEY "holdout scenarios pass, unverified $(grep -oE '^S[0-9]+' $UNVERIFIED/$KEY.md | paste -sd, -) (no data / no preview): hand-check them in the quiz (Q): $(cat $LOG_DIR/$KEY.mr)"
    else
      info $KEY "holdout scenarios pass: $(cat $LOG_DIR/$KEY.mr)"
    fi
  elif (( RC == 3 )); then
    relabel $KEY "" ai-verify-failed; note $KEY "verifier crashed or died mid-run, see \`$REPORT\` + \`$LOG_DIR/$KEY.log\`"
  elif (( RC == 4 )); then
    relabel $KEY "" ai-verify-failed; note $KEY "verify blocked (env/data), see \`$REPORT\`"
  elif has_label $KEY ai-verify-retry; then
    relabel $KEY ai-verify-retry ai-verify-failed; note $KEY "holdout scenarios still fail after retry, see \`$REPORT\`"
  else
    exec {LK}>$LOCKS/$KEY
    if ! flock -n $LK; then
      echo "  verify failed while another stage of $KEY runs (MR follow-up): no verify-fix now, its push re-verifies, else verify runs again" | tee -a $LOG_DIR/$KEY.log
      return 0
    fi
    stale_verify $KEY "$VH" && return 0
    relabel $KEY "" ai-verify-retry
    H0=$(wt_heads $KEY)
    implement $KEY ${REPO%%,*} "--verify-fix $REPORT"
    limited && jira PUT "/rest/api/2/issue/$KEY" '{"update":{"labels":[{"remove":"ai-verify-retry"}]}}' >/dev/null
    if after_amend $KEY; then [[ "$(wt_heads $KEY)" == "$H0" ]] || unreview $KEY; relabel $KEY ai-verify-retry ai-verify-failed
    elif [[ "$(wt_heads $KEY)" == "$H0" ]]; then relabel $KEY ai-verify-retry ai-verify-failed; note $KEY "holdout scenarios failed, fix round pushed nothing, needs you: \`$REPORT\` + Jira comment"
    else env_push $KEY "$H0"; unreview $KEY; info $KEY "holdout scenarios failed, fix pushed, re-verify next run ($(failed_scenarios $REPORT) first)"; fi
  fi
  return 0
}

stage_review() {
  local KEY=$1 RC MR H=$(wt_heads $1) PRIOR=""
  has_label $KEY ai-verified && ! has_label $KEY ai-reviewed ai-review-retry ai-review-findings || { echo "  not ai-verified or already reviewed (stale search index), skipped"; return 0 }
  [[ -f $LOG_DIR/$KEY.reviewed && -f $LOG_DIR/$KEY.review.md ]] && PRIOR=$(<$LOG_DIR/$KEY.reviewed)
  if [[ -n "$PRIOR" && "$PRIOR" == "$H" ]]; then
    echo "  review: no commits since the last reviewed heads, relabel only" >>$LOG_DIR/$KEY.log
    relabel $KEY "" ai-reviewed; note $KEY "independent review: nothing new since the last review: $(cat $LOG_DIR/$KEY.mr 2>/dev/null)"
    return 0
  fi
  review $KEY $2 "$PRIOR"
  RC=$?
  (( RC == 2 )) && return 2
  MR=$(cat $LOG_DIR/$KEY.mr 2>/dev/null)
  (( RC == 0 || RC == 1 )) && echo "$H" >$LOG_DIR/$KEY.reviewed
  case $RC in
    0) relabel $KEY "" ai-reviewed; note $KEY "independent review clean: $MR" ;;
    1) relabel $KEY "" ai-reviewed; note $KEY "independent review: should-fix findings only, see the MR note: $MR" ;;
    4) relabel $KEY "" ai-review-retry; info $KEY "independent review: must-fix findings, auto-fix next: $MR" ;;
    *) relabel $KEY "" ai-review-findings; note $KEY "reviewer crashed or wrote no verdict, see \`$LOG_DIR/$KEY.log\`" ;;
  esac
  return 0
}

stage_rfix() {
  local KEY=$1 H0=$(wt_heads $1) RC MR=$(cat $LOG_DIR/$1.mr 2>/dev/null)
  has_label $KEY ai-review-retry || { echo "  no ai-review-retry (stale search index), skipped"; return 0 }
  local N=$(<$LOG_DIR/$KEY.rfix-count 2>/dev/null || echo 0)
  if (( N >= ${RFIX_MAX:-2} )); then
    relabel $KEY ai-review-retry ai-review-findings; note $KEY "review fix cap reached ($N rounds), needs you: \`$LOG_DIR/$KEY.review.md\`"
    return 0
  fi
  echo $(( N + 1 )) >$LOG_DIR/$KEY.rfix-count
  implement $KEY $2 "--review-fix $LOG_DIR/$1.review.md"
  limited && echo $N >$LOG_DIR/$KEY.rfix-count
  if [[ "$(wt_heads $KEY)" == "$H0" ]]; then
    relabel $KEY ai-review-retry ai-review-findings; note $KEY "review findings not fixed (no commits pushed), see \`$LOG_DIR/$KEY.review.md\`"
    return 0
  fi
  env_push $KEY "$H0"
  review $KEY $2 "$H0"
  RC=$?
  unverify $KEY
  (( RC == 0 || RC == 1 )) && wt_heads $KEY >$LOG_DIR/$KEY.reviewed
  case $RC in
    0|1) relabel $KEY ai-review-retry ai-reviewed; info $KEY "review findings fixed, re-check $( (( RC )) && echo minor || echo clean ), re-verify next: $MR" ;;
    4) relabel $KEY ai-review-retry ai-review-findings; note $KEY "review findings fixed, but the re-check still blocks, needs you: $MR" ;;
    *) relabel $KEY ai-review-retry ai-review-findings; note $KEY "re-check crashed or wrote no verdict, see \`$LOG_DIR/$KEY.log\`" ;;
  esac
}

stage_env() {
  local AF=$LOG_DIR/$2.env-auto AUTO=""
  [[ ${3:-} == auto ]] || { [[ -f $LOG_DIR/$2.env-pipe ]] && grep -q '^req ' $AF 2>/dev/null } && AUTO=1
  env_run "$@"
  [[ -n $AUTO && ! -f $LOG_DIR/$2.env-pipe ]] && grep -q '^req ' $AF 2>/dev/null && sed -i '1s/^req /failed /' $AF
  return 0
}

env_run() {
  local KEY=$2 CID=${3:-0} LOG=$LOG_DIR/$2.log PF=$LOG_DIR/$2.env-pipe OUT=$LOG_DIR/$2.env-cmd
  local ACT EN PID URL="" RES ST W=() WHYNOT Q=""
  echo "=== env $KEY (comment $CID) $(date -Iseconds)" | tee -a $LOG
  if [[ -f $PF ]]; then
    read -r PID ACT EN URL Q <$PF
    echo "  resuming pipeline $PID ($ACT $EN)" | tee -a $LOG
  else
    if [[ $CID == redeploy ]]; then rm -f $OUT; mv $LOG_DIR/$KEY.env-redeploy $OUT || return 0; Q=$(sed -n 2p $OUT); else env_resolve $KEY $CID; fi
    limit_bail $KEY
    case $CID in
      auto) rm -f $LOG_DIR/$KEY.env-req ;;
      redeploy) ;;
      *) echo $CID >$ENVHANDLED/$KEY ;;
    esac
    echo "  resolved: $(head -1 $OUT 2>/dev/null || echo nothing)" | tee -a $LOG
    if [[ "$(head -1 $OUT 2>/dev/null)" == ASK\ * ]]; then
      env_say $KEY "K prostředí potřebuju upřesnit: $(head -1 $OUT | cut -c5-)
Nic jsem nespustil. Odpověz novým komentářem, který začíná {{env:}}."
      note $KEY "env request needs an answer, see Jira"
      return 0
    fi
    if ! W=($(env_parse $OUT)); then
      env_say $KEY "Požadavek na prostředí se mi nepodařilo převést na příkaz, nic jsem nespustil. Zkus to znovu komentářem, který začíná {{env:}}."
      note $KEY "env request not resolved, see \`$LOG\`"
      return 0
    fi
    ACT=${W[1]} EN=${W[2]} WHYNOT=$(sed -n '2,6p' $OUT)
    if [[ -n $AUTO && $ACT != create ]]; then
      note $KEY "automatic dyn-env request resolved to \`$ACT $EN\`, not create: nothing started, see \`$LOG\`"
      return 0
    fi
    if [[ $ACT == use ]]; then
      if [[ "$(env_state $EN)" != up ]]; then
        env_say $KEY "Prostředí {{$EN}} neexistuje (nebo se nepodařilo ověřit jeho stav), štítek jsem nenastavil."
        return 0
      fi
      relabel $KEY "$(ticket_env $KEY | sed 's/^./env-&/')" env-$EN
      env_unverify $KEY
      env_say $KEY "Ticket se bude ověřovat na prostředí {{$EN}} (https://$EN.dev.cleverfarm.cz), štítek {{env-$EN}}. Při ověření do něj nasadím frontend z větve ticketu."
      info $KEY "env: uses $EN"
      return 0
    fi
    if [[ $ACT == destroy && "$(cat $ENVOWN/$EN 2>/dev/null)" != $KEY ]]; then
      env_say $KEY "Prostředí {{$EN}} jsem nezrušil: nevytvořila ho factory pro tento ticket. Zruš ho prosím ručně."
      return 0
    fi
    if [[ $ACT == create && "$(env_state $EN)" != gone ]]; then
      env_say $KEY "Prostředí {{$EN}} už existuje (nebo se nepodařilo ověřit jeho stav), nové jsem nevytvořil. Použít ho: {{env: použij $EN}}."
      return 0
    fi
    RES=$(cf_env run $ACT $EN ${W[3,-1]} 2>&1)
    if [[ $RES != pipeline\ * ]]; then
      [[ -n $Q ]] || env_say $KEY "Příkaz {{cf-env.sh run ${W[*]}}} se nespustil:
{noformat}
$RES
{noformat}"
      print -r -- "  $RES" >>$LOG
      note $KEY "env $ACT $EN did not start, see \`$LOG\`"
      return 0
    fi
    PID=${${=RES}[2]} URL=${${=RES}[3]}
    echo "$PID $ACT $EN $URL $Q" >$PF
    [[ $ACT == create ]] && echo $KEY >$ENVOWN/$EN
    [[ -n $Q ]] || env_say $KEY "Spouštím {{cf-env.sh run ${W[*]}}}
Pipeline: $URL$([[ $ACT == create ]] && echo "
Vytvoření trvá asi 20 minut, prostředí stojí zhruba 0,75 USD denně a přes noc a víkend spí.")${WHYNOT:+
$WHYNOT}
Špatně? Napiš {{env: zruš to}}."
  fi
  ST=$(cf_env wait $PID 2>&1 | tee -a $LOG | sed -n 1p)
  rm -f $PF
  if [[ $ST != *": success "* ]]; then
    [[ -n $Q ]] || env_say $KEY "{{$ACT $EN}} nedoběhlo (${ST:-bez odpovědi}): $URL"
    note $KEY "env $ACT \`$EN\` failed: $URL"
    return 0
  fi
  case $ACT in
    create)
      relabel $KEY "$(ticket_env $KEY | sed 's/^./env-&/')" env-$EN
      env_unverify $KEY
      env_say $KEY "Prostředí {{$EN}} běží: https://$EN.dev.cleverfarm.cz
Štítek {{env-$EN}}: ověření poběží tam, s frontendem z větve ticketu. Až bude ticket Done, prostředí samo zruším."
      if [[ -n $AUTO ]]; then
        for D in ${${=$(<$AF)}[3,-1]}; do
          [[ -z "$(ticket_env $D)" ]] && relabel $D "" env-$EN
          env_say $D "Pro ověření frontendu z $KEY, který potřebuje backend z tohoto ticketu, jsem vytvořil prostředí {{$EN}}: https://$EN.dev.cleverfarm.cz, s backendem z vašeho MR. Můžete ho používat taky, štítek {{env-$EN}}. Zruším ho, až budou hotové všechny tickety s tímhle štítkem."
        done
        rm -f $AF
      fi ;;
    redeploy)
      env_unverify $KEY
      [[ -n $Q ]] && echo "$PID $Q" >$LOG_DIR/$KEY.env-fe
      [[ -n $Q ]] || env_say $KEY "Nasazeno do {{$EN}}: https://$EN.dev.cleverfarm.cz. Ověření poběží znovu." ;;
    destroy)
      rm -f $ENVOWN/$EN
      [[ "$(ticket_env $KEY)" == $EN ]] && unlabel $KEY env-$EN
      env_say $KEY "Prostředí {{$EN}} je zrušené." ;;
    *) env_say $KEY "Hotovo: {{$ACT $EN}}." ;;
  esac
  info $KEY "env: $ACT $EN done ($URL)"
  return 0
}

released() {
  relabel $1 "" ai-done
  rm -rf $LOG_DIR/$1.verify-media $LOG_DIR/$1.layout-media
}

stage_done() {
  local KEY=$1 IDS="${*:2}"
  env_done $KEY
  if [[ -z "$IDS" ]]; then released $KEY; info $KEY "released"; return; fi
  if resolve_sentry $KEY ${=IDS}; then released $KEY; info $KEY "released, Sentry resolved: $IDS"; else note $KEY "Sentry resolve failed, see \`$LOG_DIR/$KEY.log\`"; fi
}

stage_conflict() {
  resolve_conflict "${@:2}"
}

stage_sentry() {
  ${SELF:h}/sentry-triage
  return 0
}

stage_deps() {
  touch $LOG_DIR/.deps-checked
  ${SELF:h}/deps-triage | tee $LOG_DIR/deps.status
}

mem_mb() { awk -v k="$1:" '$1 == k { print int($2 / 1024) }' /proc/meminfo }
swap_mb() { echo $(( $(mem_mb SwapTotal) - $(mem_mb SwapFree) )) }

run_stage() {
  local A0=$(mem_mb MemAvailable) S0=$(swap_mb) L=$LOCKS/$2 W0=$(date +%s)
  [[ $1 == verify ]] && L=$LOCKS/$2.verify
  flock -n -o -E 75 $L $SELF --stage "$@" </dev/null
  local RC=$?
  local CG=/sys/fs/cgroup$(cut -d: -f3- /proc/self/cgroup)
  local P=$(<$CG/memory.peak 2>/dev/null)
  [[ -n $P ]] && printf '%s\t%s\t%s\t%d\t%s\t%s\t%s\t%s\t%s\n' "$(date -Iseconds)" $1 $2 $(( P / 1048576 )) $A0 $(mem_mb MemAvailable) $S0 $(swap_mb) $RC >>$LOG_DIR/mem.tsv
  local CPU=$(awk '$1 == "usage_usec" { print int($2 / 1e6) }' $CG/cpu.stat 2>/dev/null) STALL=$(awk -F'total=' '/^some/ { print int($2 / 1e6) }' $CG/cpu.pressure 2>/dev/null)
  [[ -n $CPU && -n $STALL ]] && (( RC != 75 )) && printf '%s\t%s\t%s\t%d\t%d\t%d\t%s\n' "$(date -Iseconds)" $1 $2 $CPU $(( $(date +%s) - W0 )) $STALL $RC >>$LOG_DIR/cpu.tsv
  (( RC == 75 )) && echo "  $2 busy in another stage, skipped"
  if (( RC != 0 && RC != 2 && RC != 75 )); then
    echo "  stage $1 $2 crashed, exit $RC"
    note ${2#env-} "stage $1 crashed (exit $RC), see \`journalctl --user -u 'sw-factory-*'\`"
  fi
  return $RC
}

if [[ "${1:-}" == --stage ]]; then
  [[ $2 == (mr|impl) ]] && running_mark $2 $3
  stage_$2 "${@:3}"
  RC=$?
  rm -f $LOG_DIR/running/$3 $LOG_DIR/running/$3.heads
  rm -f $LIMIT.$$
  exit $RC
fi

if [[ "${1:-}" == --run ]]; then
  run_stage "${@:2}"
  exit $?
fi

if [[ "${2:-}" == --gate ]]; then
  GATE_VERBOSE=1 gate_all "key = ${1:u}"
  exit 0
fi

if [[ "${2:-}" == --conventions ]]; then
  conventions ${1:u} "$(ticket_repos ${1:u})"
  exit 0
fi

if [[ -f $LIMIT ]] && (( $(<$LIMIT) > $(date +%s) )); then
  echo "usage limit until $(date -d @$(<$LIMIT) '+%a %H:%M'), tick skipped (override: rm $LIMIT)"
  exit 0
fi

zmodload zsh/datetime
T0=$EPOCHREALTIME GLMODE=-

stage_class() { case $1 in impl|mr|verify|review) echo $1 ;; rfix) echo impl ;; esac }
stage_timeout() { case $1 in impl|mr|rfix|conflict|verify|env) echo 110min ;; review) echo 45min ;; done) echo 5min ;; *) echo 30min ;; esac }

RUNNING=(${(f)"$(systemctl --user list-units 'sw-factory-*' --state=active,activating,deactivating --plain --no-legend | awk '{print $1}')"})
TAKEN=() SPAWNED=0

pick_slot() {
  local I F
  for (( I=1; I<=$2; I++ )); do
    F=$SLOTDIR/$1$I
    (( ${TAKEN[(Ie)$F]} )) && continue
    flock -n $F true 2>/dev/null || continue
    PICKED=$F
    return 0
  done
  return 1
}

spawn_stage() {
  local S=$1 KEY=${2//[^A-Za-z0-9_.-]/-} CLS SLOT CAP=() F CMD=() N
  local UNIT=sw-factory-$KEY-$S RK=(${(M)RUNNING:#sw-factory-$KEY-*})
  if (( $#RK )); then
    [[ $S == mr && -z ${RK:#sw-factory-$KEY-verify.service} ]] || { (( $#RK == 1 )) && restart_young $S $KEY $RK[1] </dev/null; return 1 }
  fi
  pick_slot slot- $SLOTS || return 3
  SLOT=$PICKED
  CLS=$(stage_class $S)
  if [[ -n $CLS ]]; then
    N=$IMPL_SLOTS
    [[ $CLS == verify ]] && N=$VERIFY_SLOTS
    [[ $CLS == mr ]] && N=$MR_SLOTS
    [[ $CLS == review ]] && N=$REVIEW_SLOTS
    pick_slot $CLS- $N || return 4
    CAP=($PICKED)
  fi
  for F in $SLOT $CAP; do CMD+=(flock -n -o -E 75 $F); done
  CMD+=($SELF --run $S $2 "${@:3}")
  if [[ -n "${TRIAGE_DRY:-}" ]]; then
    echo "would spawn $UNIT (slots ${SLOT:t} ${CAP:t})"
  else
    systemd-run --user --collect --quiet --unit=$UNIT "--setenv=PATH=$PATH" ${GRILL:+--setenv=GRILL=$GRILL} \
      -p EnvironmentFile=$HOME/.config/jira.env -p EnvironmentFile=$HOME/.config/sw-factory.env -p RuntimeMaxSec=$(stage_timeout $S) \
      -p CPUWeight=${STAGE_CPU_WEIGHT:-20} -p Nice=10 -p SuccessExitStatus="2 75" $CMD || return 1
    echo "spawned $UNIT (slots ${SLOT:t} ${CAP:t})"
  fi
  TAKEN+=($SLOT $CAP)
  RUNNING+=($UNIT.service)
  (( SPAWNED++ ))
  return 0
}

emit() {
  local L
  while read -r L; do [[ -n "$L" ]] && echo "$1 $L"; done <<<"$2"
}

dispatch() {
  local S KEY ARGS
  while read -r S KEY ARGS; do
    [[ -z "$S" ]] && continue
    spawn_stage $S $KEY ${=ARGS}
    case $? in
      3) echo "no free slot ($SLOTS busy), rest waits for next tick"; return ;;
      4) RUNNING+=(sw-factory-${KEY//[^A-Za-z0-9_.-]/-}-held) ;;
    esac
  done
}

NEW="" IMPL="" REPLIES="" MR_REPLIES="" VERIFY="" DONE="" CONFLICT="" REVIEW="" RFIX="" DEPS="" ENVQ=""
if [[ -n "${1:-}" && "${2:-}" == --env ]]; then
  ENVQ=$(search "key = ${1:u}" 1 | jq -r --arg m "$AI_MARK" "$HUMAN_JQ"' .issues[] | ((.fields.comment.comments // []) | map(select(envcmd)) | last) as $c | select($c != null) | "env-\(.key) \(.key) \($c.id)"')
elif [[ -n "${1:-}" ]]; then
  LABELS=$(search "key = ${1:u}" 1 | jq -r '.issues[0].fields.labels | join(" ")')
  if [[ -n "${GRILL:-}" && " $LABELS " == *" needs-answer "* ]]; then
    REPLIES=$(search "key = ${1:u}" 1 | jq -r "$ROWS_JQ")
  elif [[ " $LABELS " == *" ai-fix "* ]]; then
    IMPL=$(search "key = ${1:u}" 1 | jq -r "$ROWS_JQ")
  elif [[ " $LABELS " == *" ai-mr "* && "${2:-}" == --verify ]]; then
    VERIFY=$(search "key = ${1:u}" 1 | jq -r "$REPOS_JQ")
  elif [[ " $LABELS " == *" ai-mr "* && "${2:-}" == --review ]]; then
    REVIEW=$(search "key = ${1:u}" 1 | jq -r "$REPOS_JQ")
  elif [[ " $LABELS " == *" ai-mr "* ]]; then
    MR_REPLIES=$(search "key = ${1:u}" 1 | jq -r "$ROWS_JQ")
  else
    NEW=$(search "key = ${1:u}" 1 | jq -r "$ROWS_JQ")
  fi
else
  ENVQ=$(search 'project = DEV AND labels in (triage, triaged, needs-answer, triage-failed, ai-fix, ai-fix-failed, ai-mr) AND statusCategory != Done ORDER BY updated DESC' 50 \
    | jq -r --arg m "$AI_MARK" --argjson H "$(handled_json $ENVHANDLED)" "$HUMAN_JQ"' .issues[]
      | ((.fields.comment.comments // []) | map(select(envcmd)) | last) as $c
      | select($c != null and (($c.id | tonumber) > ($H[.key] // 0))) | "env-\(.key) \(.key) \($c.id)"')
  for F in $LOG_DIR/*.env-pipe(N); do K=${${F:t}%.env-pipe}; ENVQ+=$'\n'"env-$K $K 0"; done
  ENVQ=$(awk 'NF && !s[$1]++' <<<$ENVQ)
  env_reverify
  search 'project = DEV AND labels = triage AND issuetype = Epic AND statusCategory != Done' 10 | jq -r '.issues[].key' | while read -r K; do
    [[ -n "${TRIAGE_DRY:-}" ]] && { echo "  epic $K: would drop triage" >&2; continue }
    unlabel $K triage </dev/null
    note $K "epic: factory takes child tickets only, \`triage\` removed, run \`/cf-epic $K\` (mode factory labels the children)"
  done
  NEW=$(search 'project = DEV AND labels = triage AND issuetype != Epic AND statusCategory = "To Do" ORDER BY created ASC' 50 | jq -r "$ROWS_JQ" \
    | while read -r K R; do
      if B=$(blocked_by $K </dev/null); then
        if [[ -n "${TRIAGE_DRY:-}" ]]; then echo "  $K waits for $B" >&2; else print -r -- $B >$LOG_DIR/$K.blocked-by; fi
      else
        rm -f $LOG_DIR/$K.blocked-by
        echo "$K $R"
      fi
    done | head -$MAX)
  REPLY_LABELS=triaged GRILL_HOLD=""
  [[ -n "${GRILL:-}" ]] && REPLY_LABELS="triaged, needs-answer" GRILL_HOLD=" AND labels not in (needs-answer)"
  REPLIES=$(search "project = DEV AND labels in ($REPLY_LABELS) AND labels not in (ai-mr) AND statusCategory != Done AND (statusCategory = \"To Do\" OR labels = ai-fix)" 20 | awaiting_reply)
  IMPL=$(search "project = DEV AND labels = ai-fix$GRILL_HOLD AND statusCategory != Done ORDER BY updated ASC" 20 | not_awaiting)
  if [[ -n "${GRILL:-}" && -z "${TRIAGE_DRY:-}" ]]; then
    search 'project = DEV AND labels = needs-answer AND statusCategory != Done' 20 | not_awaiting \
      | while read -r K R; do grill_remind $K; done
  fi
  MR_REPLIES=$(search 'project = DEV AND labels = ai-mr AND statusCategory != Done AND status not in ("On nightly", "To test", "Release candidate", Rejected) ORDER BY updated ASC' 20 | awaiting_reply)
  GLCHECKED=($LOG_DIR/.glnotes-checked(Nmm-${GL_FULL_EVERY:-10}))
  if (( ! ${#GLCHECKED} )); then
    GLK=all
    [[ -n "${TRIAGE_DRY:-}" ]] || touch $LOG_DIR/.glnotes-checked
  elif ! GLK=$(gl_event_keys); then
    echo "lookup failed: gitlab events, full MR note scan"
    GLK=all
  fi
  GLMODE=events
  [[ $GLK == all ]] && GLMODE=full
  [[ -n "${TRIAGE_DRY:-}" ]] && echo "gl notes: $GLMODE${GLK:+, keys: ${GLK//$'\n'/ }}"
  if [[ -n $GLK ]]; then
    GLK=" ${GLK//$'\n'/ } "
    MR_REPLIES+=$'\n'$(search 'project = DEV AND labels = ai-mr AND statusCategory != Done AND status not in ("On nightly", "To test", "Release candidate", Rejected) ORDER BY updated ASC' 20 | jq -r "$REPOS_JQ" \
      | while read -r K R; do [[ $GLK == " all " || $GLK == *" $K "* ]] && gl_pending $K $R </dev/null && echo "$K ${R%%,*}"; done)
    MR_REPLIES=$(awk 'NF && !s[$1]++' <<<$MR_REPLIES)
  fi
  RFIX=$(search 'project = DEV AND labels = ai-mr AND labels = ai-review-retry AND statusCategory != Done AND status not in ("On nightly", "To test", "Release candidate", Rejected) ORDER BY updated ASC' 20 | jq -r "$ROWS_JQ")
  REVIEW=$(search 'project = DEV AND labels = ai-mr AND labels = ai-verified AND labels not in (ai-reviewed, ai-review-retry, ai-review-findings) AND statusCategory != Done AND status not in ("On nightly", "To test", "Release candidate", Rejected) ORDER BY updated ASC' 20 | jq -r "$REPOS_JQ" \
    | while read -r K R; do mr_targets $K $R >/dev/null </dev/null && echo "$K $R"; done)
  VERIFY=$(search 'project = DEV AND labels = ai-mr AND labels not in (ai-verified, ai-verify-failed, ai-review-retry) AND statusCategory != Done AND status not in ("On nightly", "To test", "Release candidate", Rejected) ORDER BY updated ASC' 20 | jq -r "$REPOS_JQ" \
    | while read -r K R; do
      if W=$(verify_blocker $K $R </dev/null); then stall_note $K "$W"; else rm -f $STALLED/$K.*(N); echo "$K $R"; fi
    done)
  for F in $LOG_DIR/*.env-req(N); do K=${${F:t}%.env-req}; ENVQ+=$'\n'"env-$K $K auto"; done
  for F in $LOG_DIR/*.env-redeploy(N); do K=${${F:t}%.env-redeploy}; ENVQ+=$'\n'"env-$K $K redeploy"; done
  ENVQ=$(awk 'NF && !s[$1]++' <<<$ENVQ)
  GCCHECKED=($LOG_DIR/.envgc-checked(Nmm-${ENV_GC_EVERY:-10}))
  if (( ! ${#GCCHECKED} )) && [[ -z "${TRIAGE_DRY:-}" ]]; then touch $LOG_DIR/.envgc-checked; env_gc </dev/null; fi
  DONE=$(search 'project = DEV AND labels in (triaged, ai-mr, triage-failed, ai-fix-failed) AND labels not in (ai-done) AND status = Done' 5 \
    | jq -r '.issues[] | "\(.key) \(.fields.labels | map(select(startswith("sentry-")) | ltrimstr("sentry-")) | join(" "))"')
  CHECKED=($LOG_DIR/.conflicts-checked(Nmm-${CONFLICT_EVERY:-5}))
  if (( ! ${#CHECKED} )) || [[ -n "${TRIAGE_DRY:-}" ]]; then
    [[ -n "${TRIAGE_DRY:-}" ]] || { mkdir -p $LOG_DIR/conflicts; touch $LOG_DIR/.conflicts-checked }
    CONFLICT=$(conflicts | while read -r PID IID R BR TGT DRAFT GO URL; do
      conflict_due $PID $IID $R $BR $TGT $DRAFT $GO </dev/null || continue
      K=${$(grep -oiP '^dev-\d+' <<<$BR):u}
      echo "${K:-${BR//\//-}} $PID $IID $R $BR $TGT $DRAFT $GO $URL"
    done)
  fi
  DEPSCHECKED=($LOG_DIR/.deps-checked(Nmm-${DEPS_EVERY:-30}))
  (( ${#DEPSCHECKED} )) || DEPS=deps
fi

LASTFAIL=($LOG_DIR/sentry-last.txt(Nmm-15))
WORK=$(
  emit env "$ENVQ"
  emit reply "$REPLIES"
  emit mr "$MR_REPLIES"
  emit rfix "$RFIX"
  emit verify "$VERIFY"
  emit review "$REVIEW"
  emit conflict "$CONFLICT"
  emit new "$NEW"
  emit impl "$IMPL"
  emit done "$DONE"
  emit deps "$DEPS"
  if [[ -z "${1:-}" ]] && [[ "$(cat $LOG_DIR/sentry-today 2>/dev/null)" != "$(date +%F)" ]] && (( ! ${#LASTFAIL} )); then
    echo "sentry sentry"
  fi
)
TD=$EPOCHREALTIME
dispatch <<<"$WORK"
[[ -z "${1:-}" ]] && gate_all 'project = DEV AND labels = ai-mr AND statusCategory != Done AND status not in ("On nightly", "To test", "Release candidate", Rejected)'
[[ -z "${1:-}" && -z "${TRIAGE_DRY:-}" ]] && LC_NUMERIC=C printf '%s\t%.1f\t%.1f\t%s\t%d\t%s\n' "$(date -Iseconds -d @${T0%.*})" $(( TD - T0 )) $(( EPOCHREALTIME - T0 )) $GLMODE $SPAWNED "$(awk -F'avg60=' '/^some/ { split($2, a, " "); print a[1] }' /proc/pressure/cpu)" >>$LOG_DIR/ticks.tsv

if [[ -n "${1:-}" ]]; then
  (( SPAWNED )) || { echo "nothing spawned: ticket already running, no free slot, or no work for its labels" >&2; exit 75 }
  exit 0
fi
[[ -n "${TRIAGE_DRY:-}" ]] && exit 0

POSTED=$LOG_DIR/.posted QUIET=$LOG_DIR/.quiet SEND=$NOTES.$$
if [[ -s $NOTES ]] && mv $NOTES $SEND; then
  if printf '**sw-factory run %s**\n%s\n' "$(date '+%H:%M')" "$(sed 's/^/• /' $SEND)" | ~/.claude/scripts/slack-post.sh "sw-factory"; then
    rm -f $SEND $QUIET && touch $POSTED
  else
    cat $SEND >>$NOTES && rm -f $SEND
  fi
elif (( ! SPAWNED && ! ${#RUNNING} )); then
  date '+%a %H:%M' >>$QUIET
  RECENT=($POSTED(Nmh-3))
  if (( ! ${#RECENT} )); then
    printf '**sw-factory alive** — %s quiet runs since %s, nothing picked up\n' "$(wc -l <$QUIET)" "$(head -1 $QUIET)" \
      | ~/.claude/scripts/slack-post.sh "sw-factory" && rm -f $QUIET && touch $POSTED
  fi
fi
