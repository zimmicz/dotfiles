[Unit]
Description=cf-triage dispatcher: picks work, spawns each stage as its own cf-triage-<KEY>-<stage> unit within the slot caps

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:%h/.fnm/aliases/default/bin:%h/bin:/snap/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=%h/.config/cf-triage.env
ExecStart=%h/bin/triage-worker
TimeoutStartSec=10min
