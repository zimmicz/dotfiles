        "repo": "JuliusBrussee/caveman"
      }
    },
    "cleverfarm": {
      "source": {
        "source": "directory",
        "path": "/home/zimmi/work/cleverfarm/repos/cf-knowledge-base"
      }
    },
    "mempalace": {
      "source": {
        "source": "github",
        "repo": "milla-jovovich/mempalace"
      }
    },
    "voicemode": {
      "source": {
        "source": "github",
        "repo": "mbailey/voicemode"
      }
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "vim",
  "autoCompactEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
