      "Bash(git commit -m \"$\\(cat <<'EOF'\ntest: [CFD-9933] fix e2e prescription maps and nitrogen tab tests\n\nCo-Authored-By: Claude Opus 4.6 <noreply@anthropic.com>\nEOF\n\\)\")",
      "Bash(git commit --no-verify -m \"$\\(cat <<'EOF'\ntest: [CFD-9933] fix e2e prescription maps and nitrogen tab tests\n\nCo-Authored-By: Claude Opus 4.6 <noreply@anthropic.com>\nEOF\n\\)\")",
      "Bash(git push -u origin CFD-9933-e2e-test-fixes)",
