      "Bash(glab mr create --source-branch CFD-9933-e2e-test-fixes --target-branch develop --title \"test: [CFD-9933] fix e2e prescription maps and nitrogen tab tests\" --description \"$\\(cat <<'EOF'\n## Summary\n\n- Replace monolithic `fillTheForm\\(\\)` with granular step definitions \\(select operation, material, product, fill doses, submit\\)\n- Fix nitrogen tab test: remove stale date assertion, update total count\n- Add `name` attribute to dose input for reliable test targeting\n- Update dose value step locator to use `name` selector\n\n## Test plan\n\n- [ ] Run prescription maps create E2E scenarios\n- [ ] Run nitrogen tab E2E scenario\n- [ ] Verify no regressions in other precision farming tests\nEOF\n\\)\" --reviewer vaclav.skorpil,jaroslav.tesarik,barbora.kovarova --no-editor)",
      "Bash(git fetch origin production)",
      "Bash(git merge --no-ff origin/production -m \"chore: sync production to staging\")",
      "Bash(git add app/precision-farming/routes/parcel-detail/nitrogen/components/NuptTable.tsx && git commit --no-edit)",
      "Bash(git fetch origin develop)",
      "Bash(git worktree add .worktrees/CFD-9896-areas-v2-cache-invalidation origin/develop -b CFD-9896-areas-v2-cache-invalidation)",
