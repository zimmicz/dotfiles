      "mcp__atlassian__editJiraIssue",
      "Bash(git worktree add .worktrees/CFD-9933-e2e-test-fixes origin/develop -b CFD-9933-e2e-test-fixes)",
      "Bash(cd .worktrees/CFD-9933-e2e-test-fixes && git stash pop \"stash@{0}\")",
      "Bash(cd .worktrees/CFD-9933-e2e-test-fixes && git add app/precision-farming/routes/prescription-maps/create/components/ParcelDetail.tsx cucumber.cjs tests/playwright/features/precision-farming/parcel/nitrogen-tab.feature tests/playwright/features/precision-farming/prescription-maps/create.feature tests/playwright/pages/precision-farming/PrescriptionMapsCreatePage.ts tests/playwright/steps/precision-farming/prescription-maps.steps.ts)",
