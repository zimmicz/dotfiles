#!/bin/zsh
set -u

DRY=0
[[ "${1:-}" == "--dry-run" ]] && DRY=1

set -a
source $HOME/.config/jira.env
set +a

STATE=$HOME/.local/state/read-it-later
mkdir -p $STATE
STAMP=$(date +%F-%H%M)$( (( DRY )) && echo -dry)

export DISPLAY=${DISPLAY:-:0}
if ! pgrep -x chromium >/dev/null; then
  chromium --new-window about:blank >/dev/null 2>&1 &!
  sleep 20
fi

PROMPT="Process the Číst později database now."
DENY=()
if (( DRY )); then
  PROMPT="DRY RUN. $PROMPT"
  DENY=(--disallowedTools "Bash(jira:*) mcp__claude_ai_Notion__notion-update-page mcp__claude_ai_Notion__notion-create-pages mcp__claude_ai_Notion__notion-create-comment mcp__claude_ai_Notion__notion-delete-pages")
fi

cd $HOME/work/cleverfarm/agents

REPORT=()
FAILED=()

run() {
  local agent=$1 tools=$2 heading=$3
  local log=$STATE/run-$STAMP-$agent.json
  print -r -- "== $agent"
  claude -p "$PROMPT" \
    --agent $agent \
    --chrome \
    --settings '{"enabledPlugins":{"caveman@caveman":false,"ponytail@ponytail":false}}' \
    --allowedTools "$tools" \
    $DENY \
    --output-format stream-json --verbose \
    </dev/null | tee $log \
    | jq --unbuffered -r 'select(.type=="assistant") | .message.content[]? | if .type=="tool_use" then "→ \(.name | sub("^mcp__.*__"; ""))" elif .type=="text" then .text else empty end' 2>/dev/null

  local res=$(grep '"type":"result"' $log | tail -1)
  local result=$(print -r -- "$res" | jq -r '.result // empty' 2>/dev/null)

  if (( DRY )); then
    print -r -- "$res" | jq -r '"cost: $\(.total_cost_usd)"' 2>/dev/null
    return
  fi

  if [[ "$(print -r -- "$res" | jq -r '.is_error' 2>/dev/null)" != false || -z "$result" ]]; then
    FAILED+=("$agent selhal, log: $log")
    return
  fi

  [[ "$result" == NOTHING ]] || REPORT+=("**$heading**"$'\n'"$result")
}

run read-it-later-organizer "mcp__claude_ai_Notion mcp__claude-in-chrome WebFetch Bash(jira:*) Bash(jq:*)" "→ Jira"
run read-it-later-followup "mcp__claude_ai_Notion mcp__claude-in-chrome WebFetch" "→ Followupy"

(( DRY )) && exit 0

if (( ${#FAILED} )); then
  print -rl -- $FAILED | ~/.claude/scripts/slack-post.sh "Číst později: chyba"
fi

if (( ${#REPORT} )); then
  print -r -- "${(pj:\n\n:)REPORT}" | ~/.claude/scripts/slack-post.sh "Číst později"
fi

(( ${#FAILED} )) && exit 1
exit 0
