#!/bin/zsh
set -uo pipefail

MAX=${MAX:-10}
SLOTS=${SLOTS:-3} IMPL_SLOTS=${IMPL_SLOTS:-1} MR_SLOTS=${MR_SLOTS:-1} VERIFY_SLOTS=${VERIFY_SLOTS:-1}
REPOS=~/work/cleverfarm/repos
LOG_DIR=~/.local/state/cf-triage
AI_MARK="AI triage (Claude, headless)"
NOTES=$LOG_DIR/notes.txt
HOLDOUT=$LOG_DIR/holdout
SELF=${0:A}
LOCKS=$LOG_DIR/locks
SLOTDIR=$LOG_DIR/slots
HANDLED=$LOG_DIR/handled
STALLED=$LOG_DIR/stalled
mkdir -p $LOG_DIR $HOLDOUT $LOCKS $SLOTDIR $HANDLED $STALLED

STREAM_JQ='if .type == "system" and .subtype == "init" then "🆔 session \(.session_id) — reopen: cd \(.cwd) && claude --resume \(.session_id)"
  elif .type == "assistant" then (.message.content[] | if .type == "text" then "💬 " + .text elif .type == "tool_use" then "🔧 " + .name + " " + (.input | tostring)[0:200] else empty end)
  elif .type == "result" then "✅ exit error=\(.is_error) cost=$\(.total_cost_usd)\n\(.result // "")" else empty end'

stream() { jq --unbuffered -r "$STREAM_JQ" }

search() {
  jira GET "/rest/api/3/search/jql?jql=$(jq -rn --arg q "$1" '$q|@uri')&fields=labels,comment&maxResults=$2"
}

HUMAN_JQ='def human: (.body // "" | if type == "string" then . else [.. | .text? // empty] | join("") end) | contains($m) | not;'

handled_json() {
  local F
  for F in $HANDLED/*(N); do echo "${F:t} $(<$F)"; done \
    | jq -Rn '[inputs | split(" ") | select(length == 2) | {(.[0]): (.[1] | tonumber)}] | add // {}'
}

snap_human() {
  jira GET "/rest/api/3/issue/$1/comment?maxResults=1000" | jq -r --arg m "$AI_MARK" "$HUMAN_JQ"' [.comments[] | select(human) | .id | tonumber] | max // 0'
}

mark_handled() { echo ${2:-0} >$HANDLED/$1 }

answered_since() {
  jira GET "/rest/api/3/issue/$1/comment?maxResults=1000" \
    | jq -e --arg m "$AI_MARK" --argjson id ${2:-0} "$HUMAN_JQ"' any(.comments[]; (human | not) and ((.id | tonumber) > $id))' >/dev/null
}

reply_filter() {
  jq -r --arg m "$AI_MARK" --argjson w $1 --argjson H "$(handled_json)" "$HUMAN_JQ"' .issues[]
    | select((.fields.comment.comments // []) as $c
      | ($c | map(select(human)) | last) as $h
      | (if $h == null then false
         elif $H[.key] != null then (($h.id | tonumber) > $H[.key])
         else ($c | last | human) end) == $w)' \
    | jq -rs "{issues: .} | $ROWS_JQ"
}

awaiting_reply() { reply_filter true }
not_awaiting() { reply_filter false }

note() {
  echo "[$1](https://cleverfarm.atlassian.net/browse/$1) $2" >>$NOTES
}

relabel() {
  local OPS="{\"add\":\"$3\"}"
  [[ -n "$2" ]] && OPS="{\"remove\":\"$2\"},$OPS"
  jira PUT "/rest/api/2/issue/$1" "{\"update\":{\"labels\":[$OPS]}}" >/dev/null
}

resolve_sentry() {
  local KEY=$1; shift
  claude -p "Sentry org cleverfarm-sro, regionUrl https://us.sentry.io. No human present, never ask. For EACH of these issue short ids: $* -> update_issue status 'resolved', reason 'Jira $KEY released'. Final answer: 'done' if all succeeded, else the errors." \
    --model haiku --allowedTools "mcp__claude_ai_Sentry__update_issue" --output-format json </dev/null 2>>$LOG_DIR/$KEY.log \
    | jq -e '(.is_error | not) and (.permission_denials | length == 0) and (.result | test("^done"; "i"))' >/dev/null
}

analyze() {
  local KEY=$1 REPO=${2-} LOG=$LOG_DIR/$1.log
  echo "=== $KEY ($REPO) $(date -Iseconds)" | tee -a $LOG
  if [[ -z "$REPO" || ! -d $REPOS/$REPO/.git ]]; then
    echo "  no repo '$REPO'" | tee -a $LOG
    return 1
  fi
  local SETUP=$(cd $REPOS/$REPO && cf-work $KEY --no-launch --no-claim 2>&1)
  echo "$SETUP" >>$LOG
  local WT=($REPOS/$REPO/.worktrees/${KEY}-*(N/[1]))
  local TIER=$(grep -oP 'claude --model \K\w+' <<<"$SETUP" || echo sonnet)
  local DIRS=(); for D in ${(u)${(f)"$(grep -oP -- '--add-dir \K\S+' <<<"$SETUP")"}}; do DIRS+=(--add-dir $D); done
  TIER=${TIER/opusplan/opus}
  if [[ -z "$WT" ]]; then
    echo "  worktree setup failed" | tee -a $LOG
    return 1
  fi
  local PANE=$(wm_window $WT $LOG)
  (cd $WT && TMUX_PANE=$PANE claude -p "/cf-work $KEY --headless" \
    --model $TIER $DIRS \
    --allowedTools "Read Write(./PLAN.md) Edit(./PLAN.md) Write(/$HOLDOUT/$KEY.md) Edit(/$HOLDOUT/$KEY.md) Write(/$HOLDOUT/$KEY.api.md) Edit(/$HOLDOUT/$KEY.api.md) mcp__lean-ctx__ctx_read mcp__lean-ctx__ctx_search mcp__lean-ctx__ctx_glob mcp__lean-ctx__ctx_tree mcp__lean-ctx__ctx_compose mcp__codegraph__codegraph_explore mcp__claude_ai_Sentry__get_sentry_resource mcp__claude_ai_Sentry__search_events Bash(git log:*) Bash(git show:*) Bash(git blame:*) Bash(git grep:*) Bash(jira add-comment:*)" \
    --output-format stream-json --verbose </dev/null 2>>$LOG | stream >>$LOG) && [[ -f $WT/PLAN.md ]] \
    && echo "  ok -> $WT/PLAN.md" | tee -a $LOG
  local RC=$? F
  for F in $HOLDOUT/$KEY.md:holdout.md $HOLDOUT/$KEY.api.md:holdout.api.md; do
    [[ -f ${F%%:*} ]] && { jira attach $KEY ${F%%:*} ${F##*:} >/dev/null || echo "  holdout attach failed: ${F##*:}" | tee -a $LOG; }
  done
  return $RC
}

wm_window() {
  local WT=$1 LOG=$2
  tmux ls >/dev/null 2>&1 || return 0
  tmux has-session -t cf-triage 2>/dev/null || tmux new-session -d -s cf-triage -n log
  local PANE=$(tmux list-panes -s -t cf-triage -f "#{==:#{pane_current_path},$WT}" -F '#{pane_id}' | head -1)
  [[ -n "$PANE" ]] || PANE=$(tmux new-window -d -t cf-triage: -n ${WT:t} -c $WT -P -F '#{pane_id}' "tail -n +1 -f $LOG")
  echo $PANE
}

implement() {
  local KEY=$1 REPO=${2-} LOG=$LOG_DIR/$1.log
  echo "=== implement $KEY ($REPO) $(date -Iseconds)" | tee -a $LOG
  [[ -n "$REPO" && -d $REPOS/$REPO/.git ]] || { echo "  no repo '$REPO'" | tee -a $LOG; return 1; }
  local SETUP=$(cd $REPOS/$REPO && cf-work $KEY --no-launch 2>&1)
  echo "$SETUP" >>$LOG
  local WT=($REPOS/$REPO/.worktrees/${KEY}-*(N/[1]))
  local TIER=$(grep -oP 'claude --model \K\w+' <<<"$SETUP" || echo sonnet)
  local DIRS=(); for D in ${(u)${(f)"$(grep -oP -- '--add-dir \K\S+' <<<"$SETUP")"}}; do DIRS+=(--add-dir $D); done
  [[ -n "$WT" && -f $WT/PLAN.md ]] || { echo "  no worktree/PLAN.md" | tee -a $LOG; return 1; }
  local PANE=$(wm_window $WT $LOG)
  (cd $WT && TMUX_PANE=$PANE claude -p "/cf-ticket $KEY --headless ${3:-}" \
    --model $TIER $DIRS \
    --allowedTools "Read Edit Write Skill Agent mcp__lean-ctx__ctx_read mcp__lean-ctx__ctx_search mcp__lean-ctx__ctx_glob mcp__lean-ctx__ctx_tree mcp__lean-ctx__ctx_compose mcp__codegraph__codegraph_explore mcp__claude_ai_Sentry__get_sentry_resource mcp__claude_ai_Sentry__search_events Bash(nr:*) Bash(pnpm:*) Bash(npx:*) Bash(git:*) Bash(glab mr create:*) Bash(glab mr list:*) Bash(glab mr view:*) Bash(glab api:*) Bash(jira:*) Bash(jq:*)" \
    --disallowedTools "Bash(git push --force:*) Bash(git push -f:*) Bash(git push origin develop:*) Bash(git push origin staging:*) Bash(git push origin production:*) Bash(git reset --hard:*) Bash(glab mr merge:*) Bash(glab mr approve:*) Edit(/$HOLDOUT/**) Write(/$HOLDOUT/**)" \
    --output-format stream-json --verbose </dev/null 2>>$LOG | stream >>$LOG)
  local MR=$(cd $WT && glab mr list --source-branch "${WT:t}" -F json 2>/dev/null | jq -r '.[0].web_url // empty')
  [[ -n "$MR" ]] && echo "  mr -> $MR" | tee -a $LOG && echo "$MR" >$LOG_DIR/$KEY.mr
}

why() { [[ -n "${WHY:-}" ]] && echo "$1" >$WHY; return 2 }

verify_targets() {
  local KEY=$1 R WT MR PID IID PIPE SHA PS
  [[ -n "$2" ]] || { why "no repo-* label"; return 2 }
  for R in ${(s:,:)2}; do
    WT=($REPOS/$R/.worktrees/${KEY}-*(N/[1]))
    [[ -n "$WT" ]] || { why "no worktree in $R"; return 2 }
    MR=$(cd $WT && glab mr list --source-branch "${WT:t}" -F json 2>/dev/null </dev/null | jq -c '.[0] // empty')
    [[ -n "$MR" ]] || { why "no open MR in $R"; return 2 }
    PID=$(jq -r .project_id <<<$MR) IID=$(jq -r .iid <<<$MR)
    PIPE=$(glab api "projects/$PID/merge_requests/$IID/pipelines" </dev/null | jq -c '.[0] // empty')
    PS=$(jq -r .status <<<$PIPE)
    [[ "$PS" == success ]] || { why "pipeline ${PS:-missing} in $R, $(jq -r .web_url <<<$MR)"; return 2 }
    SHA=$(jq -r .sha <<<$PIPE)
    if [[ $2 == cf-farm-frontend ]]; then
      glab api "projects/$PID/merge_requests/$IID/notes?per_page=100" </dev/null \
        | jq -e --arg s "${SHA[1,8]}" 'any(.[]; (.body | contains("amplify-preview-url")) and (.body | contains("@ " + $s)))' >/dev/null || { why "Amplify preview note missing for ${SHA[1,8]} in $R"; return 2 }
    fi
    echo "$R:$PID:$IID:$(jq -r .id <<<$PIPE):${SHA[1,8]}"
  done
}

verify_blocker() {
  local F=$(mktemp)
  if [[ ! -f $HOLDOUT/$1.md ]]; then
    echo "no holdout scenarios file"
  elif WHY=$F verify_targets $1 $2 >/dev/null </dev/null; then
    rm -f $F
    return 1
  else
    cat $F
  fi
  rm -f $F
}

stall_note() {
  local S=$STALLED/$1.since A=$STALLED/$1.alert NOW=$(date +%s)
  [[ -f $S ]] || { echo $NOW >$S; return }
  (( NOW - $(<$S) < ${STALL_HOURS:-4} * 3600 )) && return
  [[ -f $A ]] && (( NOW - $(<$A) < 86400 )) && return
  note $1 "ai-mr not verified for $(( (NOW - $(<$S)) / 3600 )) h: $2"
  echo $NOW >$A
}

verify() {
  local KEY=$1 KIND=${3:-ui} LOG=$LOG_DIR/$1.log WT0 T
  local OUT=$LOG_DIR/$KEY.verify$([[ $KIND == api ]] && echo -api).md SCEN=$HOLDOUT/$KEY$([[ $KIND == api ]] && echo .api).md
  local TARGETS=() WTA=() RS=(${(s:,:)2})
  [[ -f $SCEN ]] || return 2
  T=$(verify_targets $KEY $2) || return 2
  TARGETS=(${(f)T})
  WTA=($REPOS/${RS[1]}/.worktrees/${KEY}-*(N/[1]))
  [[ -n "$WTA" ]] || return 2
  WT0=$WTA
  echo "=== verify-$KIND $KEY (${(j:, :)TARGETS}) $(date -Iseconds)" | tee -a $LOG
  local MEDIA=$LOG_DIR/$KEY.verify-media
  rm -rf $OUT $MEDIA
  local CF_ENV=$(find ~/.claude/plugins/cache -type f -name cf-env.sh -path '*/cf-dyn-env/*' 2>/dev/null | sort -V | tail -1)
  local MCP=$(jq -nc --arg d $MEDIA '{mcpServers:{playwright:{type:"stdio",command:"npx",args:["-y","@playwright/mcp@0.0.83","--headless","--executable-path","/usr/bin/chromium","--caps","devtools","--output-dir",$d]}}}')
  local PANE=$(wm_window $WT0 $LOG)
  mkdir -p ~/cf-env-tmp
  (cd $WT0 && TMUX_PANE=$PANE TMPDIR=$HOME/cf-env-tmp claude -p "/cf-verify-$KIND $KEY repos=${(j:,:)TARGETS} branch=${WT0:t}$([[ $KIND == ui ]] && echo " video=$MEDIA/$KEY.webm")" \
    --model sonnet \
    --strict-mcp-config --mcp-config "$MCP" \
    --allowedTools "Read Skill Write(/$OUT) mcp__playwright Bash(glab mr note:*) Bash(glab api:*) Bash($CF_ENV:*) Bash(jq:*) Bash(curl:*) Bash(node $HOME/.claude/skills/cf-verify-api/token.mjs:*)" \
    --disallowedTools "Edit Bash(git:*)" \
    --output-format stream-json --verbose </dev/null 2>>$LOG | stream >>$LOG)
  local VERDICT=$(head -1 $OUT 2>/dev/null)
  echo "  ${VERDICT:-no report}" | tee -a $LOG
  case $VERDICT in
    "VERDICT: pass"*) return 0 ;;
    "VERDICT: fail"*) return 1 ;;
    "VERDICT: blocked"*) return 4 ;;
    *) return 3 ;;
  esac
}

conflicts() {
  glab api "merge_requests?scope=created_by_me&state=opened&per_page=100" | jq -r '.[] | "\(.project_id) \(.iid)"' \
    | while read -r PID IID; do
        glab api "projects/$PID/merge_requests/$IID?with_merge_status_recheck=true" </dev/null \
          | jq -r 'select(.has_conflicts) | "\(.project_id) \(.iid) \(.references.full | sub("!.*"; "") | split("/") | last) \(.source_branch) \(.target_branch) \(.draft) \(.labels | index("ai-rebase") != null) \(.web_url)"'
      done
}

rebasing() { (cd $1 && [[ -d $(git rev-parse --git-path rebase-merge) ]]) }

lock_resolve() {
  local WT=$1 U REST
  while rebasing $WT; do
    U=(${(f)"$(git -C $WT diff --name-only --diff-filter=U)"})
    REST=(${U:#*pnpm-lock.yaml})
    (( ${#U} && ! ${#REST} )) || return 1
    git -C $WT checkout -q --ours -- $U
    (cd $WT && pnpm install --lockfile-only </dev/null >/dev/null 2>&1) || return 1
    git -C $WT add -- $U
    GIT_EDITOR=true git -C $WT rebase --continue >/dev/null 2>&1
  done
  return 0
}

conflict_state() {
  local GIT=$1 TGT=$2 BR=$3 DRAFT=$4 GO=$5
  [[ -d $GIT/.git ]] || { echo norepo; return }
  git -C $GIT fetch -q origin $TGT $BR || return 1
  echo "$(git -C $GIT rev-parse origin/$BR) $DRAFT $GO"
}

conflict_due() {
  local PID=$1 IID=$2 R=$3 BR=$4 TGT=$5 DRAFT=$6 GO=$7 STATE
  STATE=$(conflict_state $REPOS/$R $TGT $BR $DRAFT $GO) || return 1
  [[ "$(cat $LOG_DIR/conflicts/$PID-$IID 2>/dev/null)" != "$STATE" ]]
}

resolve_conflict() {
  local PID=$1 IID=$2 R=$3 BR=$4 TGT=$5 DRAFT=$6 GO=$7 URL=$8
  local GIT=$REPOS/$R KEY=${$(grep -oiP '^dev-\d+' <<<$BR):u} MARK=$LOG_DIR/conflicts/$1-$2
  local LOG=$LOG_DIR/${KEY:-$BR}.log REPORT=$MARK.md WHO="$URL (${KEY:-$BR})"
  local OLD STATE
  STATE=$(conflict_state $GIT $TGT $BR $DRAFT $GO) || return
  [[ $STATE == norepo ]] || OLD=${STATE%% *}
  [[ "$(cat $MARK 2>/dev/null)" == "$STATE" ]] && return
  echo $STATE >$MARK
  [[ $STATE == norepo ]] && { echo "$WHO conflicts, no local repo $R" >>$NOTES; return }
  echo "=== conflict $URL onto $TGT $(date -Iseconds)" | tee -a $LOG
  local GATED=false
  [[ $DRAFT != true || -n "$(glab api projects/$PID/merge_requests/$IID/approvals | jq -r '.approved_by[]?')" ]] && [[ $GO != true ]] && GATED=true
  if git -C $GIT log --format=%ae origin/$TGT..origin/$BR | grep -qvxF "$(git -C $GIT config user.email)"; then
    echo "$WHO conflicts with $TGT, has others' commits → resolve by hand" >>$NOTES; return
  fi
  local BOTH=$(comm -12 <(git -C $GIT diff --name-only origin/$TGT...origin/$BR | sort) <(git -C $GIT diff --name-only origin/$BR...origin/$TGT | sort) | wc -l)
  if (( BOTH > ${CONFLICT_MAX_FILES:-10} )); then
    echo "$WHO conflicts with $TGT, $BOTH files changed on both sides → resolve interactively" >>$NOTES; return
  fi
  local WT=$(git -C $GIT worktree list --porcelain | awk -v b="branch refs/heads/$BR" '/^worktree /{p=substr($0,10)} $0==b{print p}')
  if [[ -z "$WT" ]]; then
    WT=$GIT/.worktrees/$BR
    git -C $GIT worktree add -q $WT $BR 2>/dev/null || git -C $GIT worktree add -q -b $BR $WT origin/$BR || return
  fi
  if [[ -n "$(git -C $WT status --porcelain -uno)" || "$(git -C $WT rev-parse HEAD)" != $OLD ]]; then
    echo "$WHO conflicts with $TGT, worktree \`$WT\` dirty or differs from origin → resolve by hand" >>$NOTES; return
  fi
  rm -f $REPORT
  local HOW="clean rebase"
  git -C $WT rebase -q origin/$TGT >>$LOG 2>&1 || HOW="lockfile regenerated"
  if [[ $HOW != "clean rebase" ]] && ! lock_resolve $WT; then
    if [[ $GATED == true ]]; then
      git -C $WT rebase --abort
      echo "  code conflict, MR under review → waiting for ai-rebase" | tee -a $LOG
      echo "$WHO conflicts with $TGT in code, under review → add MR label \`ai-rebase\` to resolve" >>$NOTES; return
    fi
    local PANE=$(wm_window $WT $LOG)
    (cd $WT && TMUX_PANE=$PANE claude -p "Rebase of branch $BR onto origin/$TGT is in progress in this worktree and stopped on conflicts. No human present, never ask. Run /mattpocock-skills:resolving-merge-conflicts. Intent of this branch: its MR $URL + PLAN.md / TICKET.md here if present. Intent of the other side: the commits on origin/$TGT touching each conflicted file (git log origin/$TGT -- <file>) and their MRs (glab api). Keep both intents. pnpm-lock.yaml: never hand-merge, git checkout --ours it, then pnpm install --lockfile-only. Continue with GIT_EDITOR=true git rebase --continue until the rebase is finished. Then run the repo's lint, typecheck and the tests touching the conflicted files (per its CLAUDE.md), fix only what the resolution broke, amend into the rebased commits. Never push, never skip or drop commits. Not confident about a hunk → stop. Write $REPORT: first line exactly RESOLVED or FAILED: <reason>, then markdown bullets for a reviewer skimming an MR note, one per conflicted file: - \`<path>\`: kept <X>, dropped <Y>, <why in one short clause> (max 2 lines each, no paragraphs). If the resolution forced a follow-up edit in a file that did not conflict, one more bullet for it. Last bullet: - Checks: <what ran, result>." \
      --model opus \
      --allowedTools "Read Edit Write Skill mcp__lean-ctx__ctx_read mcp__lean-ctx__ctx_search mcp__lean-ctx__ctx_glob mcp__lean-ctx__ctx_tree mcp__lean-ctx__ctx_compose mcp__codegraph__codegraph_explore Bash(git:*) Bash(pnpm:*) Bash(nr:*) Bash(npx:*) Bash(glab api:*) Bash(glab mr view:*) Bash(jq:*)" \
      --disallowedTools "Bash(git push:*) Bash(git reset --hard:*) Bash(git rebase --skip:*) Bash(git rebase --abort:*) Bash(glab mr merge:*) Bash(glab mr approve:*) Edit(/$HOLDOUT/**) Write(/$HOLDOUT/**)" \
      --output-format stream-json --verbose </dev/null 2>>$LOG | stream >>$LOG)
    if rebasing $WT || [[ "$(head -1 $REPORT 2>/dev/null)" != RESOLVED ]]; then
      rebasing $WT && git -C $WT rebase --abort
      echo "  conflict resolve failed: $(head -1 $REPORT 2>/dev/null)" | tee -a $LOG
      echo "$WHO conflict resolve failed: $(head -1 $REPORT 2>/dev/null || echo 'no report'), see \`$LOG\`" >>$NOTES; return
    fi
    HOW=$(tail -n +2 $REPORT | sed -E '/^[[:space:]]*$/d; /^[[:space:]]*[-*] /!s/^/- /')
  fi
  if [[ $(git -C $WT rev-list --count origin/$TGT..HEAD) != $(git -C $GIT rev-list --count origin/$TGT..$OLD) ]]; then
    git -C $WT reset -q --hard $OLD
    echo "$WHO rebase dropped commits, not pushed, reset to $OLD → resolve by hand" >>$NOTES; return
  fi
  git -C $WT push -q --force-with-lease=$BR:$OLD origin HEAD:$BR >>$LOG 2>&1 || { echo "$WHO resolved but push rejected, see \`$LOG\`" >>$NOTES; return }
  [[ $GO == true ]] && glab api -X PUT projects/$PID/merge_requests/$IID -f remove_labels=ai-rebase >/dev/null
  glab api -X POST projects/$PID/merge_requests/$IID/notes -f body="🤖 _I'm writing on Michal's behalf. If you don't like it, please let me know._

Rebased onto \`$TGT\`, conflicts resolved:

$HOW${${GATED:#false}:+

No code changed: git applied every commit as is, only \`pnpm-lock.yaml\` was regenerated if it conflicted. Existing approvals stay valid.}" >/dev/null
  echo "  rebased + pushed" | tee -a $LOG
  if [[ $HOW != (clean\ rebase|lockfile\ regenerated) && -n "$KEY" ]] && search "key = $KEY AND labels = ai-verified" 1 | jq -e '.issues | length > 0' >/dev/null; then
    jira PUT "/rest/api/2/issue/$KEY" '{"update":{"labels":[{"remove":"ai-verified"}]}}' >/dev/null
    echo "$WHO rebased, conflicts resolved by agent, holdout re-verify queued" >>$NOTES
  else
    echo "$WHO rebased onto $TGT (${${HOW%%$'\n'*}#- })" >>$NOTES
  fi
}

ROWS_JQ='.issues[] | "\(.key) \((.fields.labels | map(select(startswith("repo-"))) | sort_by(. != "repo-cf-farm-frontend") | first // "repo-") | ltrimstr("repo-"))"'
REPOS_JQ='.issues[] | "\(.key) \(.fields.labels | map(select(startswith("repo-")) | ltrimstr("repo-")) | sort_by(. != "cf-farm-frontend") | join(","))"'

stage_new() {
  local ID=$(snap_human $1)
  if analyze $1 $2; then mark_handled $1 $ID; relabel $1 triage triaged; note $1 "triaged, PLAN.md ready (add \`ai-fix\` to implement)"; else relabel $1 triage triage-failed; note $1 "triage failed, see \`$LOG_DIR/$1.log\`"; fi
}

stage_reply() {
  echo "--- follow-up $1"
  local ID=$(snap_human $1)
  if analyze $1 $2; then mark_handled $1 $ID; note $1 "your reply answered"; else relabel $1 triaged triage-failed; note $1 "reply follow-up failed, parked as \`triage-failed\` (re-add \`triage\` to retry), see \`$LOG_DIR/$1.log\`"; fi
}

stage_impl() {
  local ID=$(snap_human $1)
  if implement $1 $2; then mark_handled $1 $ID; relabel $1 ai-fix ai-mr; note $1 "draft MR: $(cat $LOG_DIR/$1.mr)"; elif search "key = $1 AND status = Done" 1 | jq -e '.issues | length > 0' >/dev/null; then relabel $1 ai-fix triaged; note $1 "already fixed, closed as duplicate, Sentry resolves next run"; else relabel $1 ai-fix ai-fix-failed; note $1 "ai-fix failed / bailed out, see Jira comment + \`$LOG_DIR/$1.log\`"; fi
}

wt_heads() {
  local W
  for W in $REPOS/*/.worktrees/$1-*(N/); do echo "${W:t} $(git -C $W rev-parse HEAD 2>/dev/null)"; done
}

unverify() {
  jira PUT "/rest/api/2/issue/$1" '{"update":{"labels":[{"remove":"ai-verified"},{"remove":"ai-verify-failed"},{"remove":"ai-verify-retry"}]}}' >/dev/null
}

stage_mr() {
  echo "--- MR follow-up $1"
  local ID=$(snap_human $1) H0=$(wt_heads $1)
  implement $1 $2
  if answered_since $1 $ID; then
    mark_handled $1 $ID
    if [[ "$(wt_heads $1)" != "$H0" ]]; then unverify $1; note $1 "your reply answered on MR, new commits pushed, verify labels dropped, re-verify next: $(cat $LOG_DIR/$1.mr)"; else note $1 "your reply answered on MR: $(cat $LOG_DIR/$1.mr)"; fi
  else relabel $1 ai-mr ai-fix-failed; note $1 "MR follow-up failed, see \`$LOG_DIR/$1.log\`"; fi
}

stage_verify() {
  local KEY=$1 REPO=$2 RC REPORT=$LOG_DIR/$1.verify.md
  verify $KEY $REPO ui
  RC=$?
  (( RC == 2 )) && return 2
  if (( RC == 0 )) && [[ -f $HOLDOUT/$KEY.api.md ]]; then
    REPORT=$LOG_DIR/$KEY.verify-api.md
    verify $KEY $REPO api
    RC=$?
    (( RC == 2 )) && return 2
  fi
  if (( RC == 0 )); then
    relabel $KEY ai-verify-retry ai-verified; note $KEY "holdout scenarios pass: $(cat $LOG_DIR/$KEY.mr)"
  elif (( RC == 3 )); then
    relabel $KEY "" ai-verify-failed; note $KEY "verifier crashed, see \`$LOG_DIR/$KEY.log\`"
  elif (( RC == 4 )); then
    relabel $KEY "" ai-verify-failed; note $KEY "verify blocked (env/data), see \`$REPORT\`"
  elif search "key = $KEY AND labels = ai-verify-retry" 1 | jq -e '.issues | length > 0' >/dev/null; then
    relabel $KEY ai-verify-retry ai-verify-failed; note $KEY "holdout scenarios still fail after retry, see \`$REPORT\`"
  else
    relabel $KEY "" ai-verify-retry
    implement $KEY ${REPO%%,*} "--verify-fix $REPORT"
    note $KEY "holdout scenarios failed, fix pushed, re-verify next run"
  fi
  return 0
}

stage_done() {
  local KEY=$1 IDS="${*:2}"
  if [[ -z "$IDS" ]]; then relabel $KEY "" ai-done; note $KEY "released"; return; fi
  if resolve_sentry $KEY ${=IDS}; then relabel $KEY "" ai-done; note $KEY "released, Sentry resolved: $IDS"; else note $KEY "Sentry resolve failed, see \`$LOG_DIR/$KEY.log\`"; fi
}

stage_conflict() {
  resolve_conflict "${@:2}"
}

stage_sentry() {
  ${SELF:h}/sentry-triage
  return 0
}

run_stage() {
  flock -n -o -E 75 $LOCKS/$2 $SELF --stage "$@" </dev/null
  local RC=$?
  (( RC == 75 )) && echo "  $2 busy in another stage, skipped"
  if (( RC != 0 && RC != 2 && RC != 75 )); then
    echo "  stage $1 $2 crashed, exit $RC"
    note $2 "stage $1 crashed (exit $RC), see \`journalctl --user -u 'cf-triage-*'\`"
  fi
  return $RC
}

if [[ "${1:-}" == --stage ]]; then
  stage_$2 "${@:3}"
  exit $?
fi

if [[ "${1:-}" == --run ]]; then
  run_stage "${@:2}"
  exit $?
fi

stage_class() { case $1 in impl|mr|verify) echo $1 ;; esac }
stage_timeout() { case $1 in impl|mr|conflict|verify) echo 110min ;; done) echo 5min ;; *) echo 30min ;; esac }

RUNNING=(${(f)"$(systemctl --user list-units 'cf-triage-*' --state=active,activating,deactivating --plain --no-legend | awk '{print $1}')"})
TAKEN=() SPAWNED=0

pick_slot() {
  local I F
  for (( I=1; I<=$2; I++ )); do
    F=$SLOTDIR/$1$I
    (( ${TAKEN[(Ie)$F]} )) && continue
    flock -n $F true 2>/dev/null || continue
    PICKED=$F
    return 0
  done
  return 1
}

spawn_stage() {
  local S=$1 KEY=${2//[^A-Za-z0-9_.-]/-} CLS SLOT CAP=() F CMD=() N
  local UNIT=cf-triage-$KEY-$S
  [[ -n ${(M)RUNNING:#cf-triage-$KEY-*} ]] && return 1
  pick_slot slot- $SLOTS || return 3
  SLOT=$PICKED
  CLS=$(stage_class $S)
  if [[ -n $CLS ]]; then
    N=$IMPL_SLOTS
    [[ $CLS == verify ]] && N=$VERIFY_SLOTS
    [[ $CLS == mr ]] && N=$MR_SLOTS
    pick_slot $CLS- $N || return 4
    CAP=($PICKED)
  fi
  for F in $SLOT $CAP; do CMD+=(flock -n -o -E 75 $F); done
  CMD+=($SELF --run $S $2 "${@:3}")
  if [[ -n "${TRIAGE_DRY:-}" ]]; then
    echo "would spawn $UNIT (slots ${SLOT:t} ${CAP:t})"
  else
    systemd-run --user --collect --quiet --unit=$UNIT "--setenv=PATH=$PATH" \
      -p EnvironmentFile=$HOME/.config/cf-triage.env -p RuntimeMaxSec=$(stage_timeout $S) \
      -p SuccessExitStatus="2 75" $CMD || return 1
    echo "spawned $UNIT (slots ${SLOT:t} ${CAP:t})"
  fi
  TAKEN+=($SLOT $CAP)
  RUNNING+=($UNIT.service)
  (( SPAWNED++ ))
  return 0
}

emit() {
  local L
  while read -r L; do [[ -n "$L" ]] && echo "$1 $L"; done <<<"$2"
}

dispatch() {
  local S KEY ARGS
  while read -r S KEY ARGS; do
    [[ -z "$S" ]] && continue
    spawn_stage $S $KEY ${=ARGS}
    (( $? == 3 )) && { echo "no free slot ($SLOTS busy), rest waits for next tick"; return }
  done
}

NEW="" IMPL="" REPLIES="" MR_REPLIES="" VERIFY="" DONE="" CONFLICT=""
if [[ -n "${1:-}" ]]; then
  LABELS=$(search "key = ${1:u}" 1 | jq -r '.issues[0].fields.labels | join(" ")')
  if [[ " $LABELS " == *" ai-fix "* ]]; then
    IMPL=$(search "key = ${1:u}" 1 | jq -r "$ROWS_JQ")
  elif [[ " $LABELS " == *" ai-mr "* && "${2:-}" == --verify ]]; then
    VERIFY=$(search "key = ${1:u}" 1 | jq -r "$REPOS_JQ")
  elif [[ " $LABELS " == *" ai-mr "* ]]; then
    MR_REPLIES=$(search "key = ${1:u}" 1 | jq -r "$ROWS_JQ")
  else
    NEW=$(search "key = ${1:u}" 1 | jq -r "$ROWS_JQ")
  fi
else
  NEW=$(search 'project = DEV AND labels = triage AND statusCategory = "To Do" ORDER BY created ASC' $MAX | jq -r "$ROWS_JQ")
  REPLIES=$(search 'project = DEV AND labels = triaged AND labels not in (ai-mr) AND statusCategory != Done AND (statusCategory = "To Do" OR labels = ai-fix)' 20 | awaiting_reply)
  IMPL=$(search 'project = DEV AND labels = ai-fix AND statusCategory != Done ORDER BY updated ASC' 20 | not_awaiting)
  MR_REPLIES=$(search 'project = DEV AND labels = ai-mr AND statusCategory != Done AND status not in ("On nightly", "To test", "Release candidate", Rejected) ORDER BY updated ASC' 20 | awaiting_reply)
  VERIFY=$(search 'project = DEV AND labels = ai-mr AND labels not in (ai-verified, ai-verify-failed) AND statusCategory != Done AND status not in ("On nightly", "To test", "Release candidate", Rejected) ORDER BY updated ASC' 20 | jq -r "$REPOS_JQ" \
    | while read -r K R; do
      if W=$(verify_blocker $K $R </dev/null); then stall_note $K "$W"; else rm -f $STALLED/$K.*; echo "$K $R"; fi
    done)
  DONE=$(search 'project = DEV AND labels in (triaged, ai-mr, triage-failed, ai-fix-failed) AND labels not in (ai-done) AND status = Done' 5 \
    | jq -r '.issues[] | "\(.key) \(.fields.labels | map(select(startswith("sentry-")) | ltrimstr("sentry-")) | join(" "))"')
  CHECKED=($LOG_DIR/.conflicts-checked(Nmm-${CONFLICT_EVERY:-5}))
  if (( ! ${#CHECKED} )) || [[ -n "${TRIAGE_DRY:-}" ]]; then
    [[ -n "${TRIAGE_DRY:-}" ]] || { mkdir -p $LOG_DIR/conflicts; touch $LOG_DIR/.conflicts-checked }
    CONFLICT=$(conflicts | while read -r PID IID R BR TGT DRAFT GO URL; do
      conflict_due $PID $IID $R $BR $TGT $DRAFT $GO </dev/null || continue
      K=${$(grep -oiP '^dev-\d+' <<<$BR):u}
      echo "${K:-${BR//\//-}} $PID $IID $R $BR $TGT $DRAFT $GO $URL"
    done)
  fi
fi

LASTFAIL=($LOG_DIR/sentry-last.txt(Nmm-15))
WORK=$(
  emit reply "$REPLIES"
  emit mr "$MR_REPLIES"
  emit verify "$VERIFY"
  emit conflict "$CONFLICT"
  emit new "$NEW"
  emit impl "$IMPL"
  emit done "$DONE"
  if [[ -z "${1:-}" ]] && [[ "$(cat $LOG_DIR/sentry-today 2>/dev/null)" != "$(date +%F)" ]] && (( ! ${#LASTFAIL} )); then
    echo "sentry sentry"
  fi
)
dispatch <<<"$WORK"

if [[ -n "${1:-}" ]]; then
  (( SPAWNED )) || { echo "nothing spawned: ticket already running, no free slot, or no work for its labels" >&2; exit 75 }
  exit 0
fi
[[ -n "${TRIAGE_DRY:-}" ]] && exit 0

POSTED=$LOG_DIR/.posted QUIET=$LOG_DIR/.quiet SEND=$NOTES.$$
if [[ -s $NOTES ]] && mv $NOTES $SEND; then
  if printf '**cf-triage run %s**\n%s\n' "$(date '+%H:%M')" "$(sed 's/^/• /' $SEND)" | ~/.claude/scripts/slack-post.sh "cf-triage"; then
    rm -f $SEND $QUIET && touch $POSTED
  else
    cat $SEND >>$NOTES && rm -f $SEND
  fi
elif (( ! SPAWNED && ! ${#RUNNING} )); then
  date '+%a %H:%M' >>$QUIET
  RECENT=($POSTED(Nmh-3))
  if (( ! ${#RECENT} )); then
    printf '**cf-triage alive** — %s quiet runs since %s, nothing picked up\n' "$(wc -l <$QUIET)" "$(head -1 $QUIET)" \
      | ~/.claude/scripts/slack-post.sh "cf-triage" && rm -f $QUIET && touch $POSTED
  fi
fi
