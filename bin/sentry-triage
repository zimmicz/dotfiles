#!/bin/zsh
set -euo pipefail

MAX=${MAX:-1}
REPOS=~/work/cleverfarm/repos
LOG_DIR=~/.local/state/cf-triage
STAMP=$LOG_DIR/sentry-today
NOTES=$LOG_DIR/notes.txt
PIPELINE_LABELS='triage, triaged, triage-failed, ai-fix, ai-mr, ai-fix-failed'
mkdir -p $LOG_DIR

DRY=0
[[ "${1:-}" == "--dry-run" ]] && DRY=1

if (( ! DRY )) && [[ "$(cat $STAMP 2>/dev/null)" == "$(date +%F)" ]]; then
  echo "already ran today"
  exit 0
fi

OPEN=()
while read -r KEY STATUS REPO; do
  [[ -z "$KEY" ]] && continue
  STATES="no repo"
  [[ -n "$REPO" && -d $REPOS/$REPO/.git ]] && STATES=$(cd $REPOS/$REPO && glab mr list --all --search $KEY -F json | jq -r '[.[].state] | unique | join(",") | if . == "" then "none" else . end' || echo "lookup failed")
  [[ "$STATES" != none && "$STATES" != no\ repo && "$STATES" != lookup\ failed && "$STATES" != *opened* && "$STATES" != *locked* ]] && continue
  OPEN+=("$KEY ($STATUS, MR: $STATES)")
done < <(jira GET "/rest/api/3/search/jql?jql=$(jq -rn --arg q "project = DEV AND labels in ($PIPELINE_LABELS) AND statusCategory != Done" '$q|@uri')&fields=key,labels,status" \
  | jq -r '.issues[] | "\(.key) \(.fields.status.name | gsub(" "; "_")) \(.fields.labels | map(select(startswith("repo-"))) | first // "" | ltrimstr("repo-"))"')
if (( ${#OPEN} )); then
  echo "blocked: ${(j:, :)OPEN}"
  if (( ! DRY )); then
    echo "no new Sentry issue today, blocking: ${(j:, :)OPEN}" >>$NOTES
    date +%F >$STAMP
    exit 0
  fi
fi

MODE="Create the tickets and assign the Sentry issues."
(( DRY )) && MODE="DRY RUN: do NOT create tickets, do NOT update Sentry. Only print what you would create (summary, labels, product, repo, belongs-in-Sentry verdict)."

PROMPT="You turn Sentry issues into Jira tickets. No human is present, never ask questions. $MODE

Sentry: org cleverfarm-sro, regionUrl https://us.sentry.io. My Sentry user id: 3546621.
Jira: use the shell wrapper \`jira <METHOD> <endpoint> [json]\` (REST, base https://cleverfarm.atlassian.net).

1. ONLY Sentry projects fe-monitoring and can-frontend, ignore all others. search_issues twice (projectSlugOrId fe-monitoring, then can-frontend), query 'is:unresolved is:unassigned', sort freq, period 90d, limit 100. Merge both lists, order by event count desc.
SHORTID = the full Sentry short id incl. project prefix, e.g. CAN-FRONTEND-JS or FE-MONITORING-6DN (never just the suffix).

2. Walk the list in order. Dedup each issue: \`jira GET \"/rest/api/3/search/jql?jql=labels%3Dsentry-<SHORTID>&fields=key\"\`. Already ticketed -> no new ticket, just do step 5 with the existing key. Stop after $MAX NEW tickets.
3. Issues in this batch with the same title in the same project = one ticket carrying every sentry-<SHORTID> label.
4. For each new ticket: get_sentry_resource on the issue (details + latest event). Create via \`jira POST /rest/api/2/issue '<json>'\`:
   - project key DEV, issuetype name Bug
   - summary: '[Sentry] <title>' (max 200 chars)
   - labels: triage, sentry-<SHORTID> (each), repo-<repo>
   - customfield_13543: [{\"id\": \"<product id>\"}]
   - description (Jira wiki markup, English, facts only, no speculation): Sentry link(s), project, culprit, level, events, users, first/last seen, environment, release, top in-app stack frames verbatim in {code} block, relevant tags, request URL/method.
   - description MUST end with section 'h3. Belongs in Sentry?' = yes/no + one-line reason. 'no' = noise to filter client-side: browser extension, bot/crawler, user offline or cancelled request, ChunkLoadError after deploy, third-party script, unsupported browser, expected 4xx, dev/localhost environment. Name the filter that should catch it (ignoreErrors / denyUrls / beforeSend) and whether an existing rule should already have matched.
   Repo + product by Sentry project:
   - fe-monitoring -> repo cf-farm-frontend; product by route: /telematics 11714, /sensors or /irrigation 11712, /actions /parcels /catalogues /stores 11711, satellite/biomonitoring/prescription 11713, else 11710
   - can-frontend -> repo can-frontend, product 11707
5. update_issue assignedTo 'user:3546621', reason 'Jira: https://cleverfarm.atlassian.net/browse/<KEY>'.
6. Final answer: one line per Sentry issue: '<SHORTID> -> <KEY> (new|existing) [sentry: yes|no]' or '<SHORTID> -> error: <why>'."

claude -p "$PROMPT" \
  --model sonnet \
  --allowedTools "mcp__claude_ai_Sentry Bash(jira:*)" \
  --output-format json \
  </dev/null | tee $LOG_DIR/sentry-$(date +%F-%H%M).json | jq -r '.result, "cost: $\(.total_cost_usd)"' | tee $LOG_DIR/sentry-last.txt

(( DRY )) && exit 0
date +%F >$STAMP
grep -oE '^[A-Z0-9-]+ -> DEV-[0-9]+ \(new.*' $LOG_DIR/sentry-last.txt \
  | sed -E 's|^([A-Z0-9-]+) -> (DEV-[0-9]+)[^[]*(\[.*\])?|new ticket [\2](https://cleverfarm.atlassian.net/browse/\2) from Sentry \1 \3|' >>$NOTES || true
